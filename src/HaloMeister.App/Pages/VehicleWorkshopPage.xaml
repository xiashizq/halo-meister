<Page
    x:Class="HaloMeister.App.Pages.VehicleWorkshopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:Loc Key='vehicle_workshop.vehicle_workshop'}" />
                <TextBlock
                    Style="{StaticResource LivePageDescriptionStyle}"
                    Text="{i18n:Loc Key='vehicle_workshop.browse_and_create_vehicle_tags_already_lo_194a4e'}"
                    />
            </StackPanel>
            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                Click="OnRefresh"
                Content="{i18n:Loc Key='vehicle_workshop.refresh'}"
                IsEnabled="False"
                VerticalAlignment="Center" />
            <Button
                x:Name="ScanButton"
                Grid.Column="2"
                Click="OnScan"
                Content="{i18n:Loc Key='vehicle_workshop.scan_vehicles'}"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}"
                VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Padding="12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock FontWeight="SemiBold" Text="{i18n:Loc Key='vehicle_workshop.loaded_vehicles'}" />
                        <TextBlock
                            x:Name="CountText"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='vehicle_workshop.not_scanned'}" />
                    </Grid>
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Row="1"
                        IsEnabled="False"
                        PlaceholderText="{i18n:Loc Key='vehicle_workshop.search_vehicles_or_tag_paths'}"
                        TextChanged="OnSearchChanged" />
                    <ListView
                        x:Name="VehicleList"
                        Grid.Row="2"
                        IsItemClickEnabled="True"
                        ItemClick="OnVehicleClicked"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,7" Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TagPath}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <StackPanel
                        x:Name="EmptyState"
                        Width="400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="38"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE7C0;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{i18n:Loc Key='vehicle_workshop.choose_a_vehicle'}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='vehicle_workshop.select_a_loaded_vehicle_to_inspect_and_cr_a9c2aa'}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        x:Name="SelectionDetails"
                        Padding="24"
                        Spacing="12"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="SelectedVehicleText"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="SelectedPathText"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SelectedDatumText"
                            FontFamily="Consolas"
                            FontSize="11" />
                        <Button
                            x:Name="SpawnButton"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Click="OnSpawn"
                            Content="{i18n:Loc Key='vehicle_workshop.spawn_vehicle_ahead'}"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="EnablePlayerControlButton"
                            HorizontalAlignment="Left"
                            Click="OnEnablePlayerControl"
                            Content="{i18n:Loc Key='vehicle_workshop.enable_player_control'}"
                            IsEnabled="False"
                            Visibility="Collapsed" />
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Severity="Informational"
                            Title="{i18n:Loc Key='vehicle_workshop.mission_loaded_vehicles_only'}"
                            Message="{i18n:Loc Key='vehicle_workshop.the_workshop_uses_the_engine_s_guarded_ob_645147'}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock
                x:Name="ConnectionText"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar
                x:Name="StatusBar"
                IsClosable="True"
                IsOpen="False" />
        </StackPanel>
    </Grid>
</Page>
