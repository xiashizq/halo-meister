<Page
    x:Class="HaloMeister.App.Pages.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1040"
            Padding="32,28,32,48"
            HorizontalAlignment="Stretch"
            Spacing="20">

            <StackPanel Spacing="5">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:Loc Key='setup.setup'}" />
                <TextBlock
                    FontSize="17"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{i18n:Loc Key='setup.prepare_halo_meister_for_live_offline_too_9c6b82'}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{i18n:Loc Key='shell.language'}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='setup.language_hint'}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="LanguageCombo"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="10">
                        <SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Play" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{i18n:Loc Key='setup.1_start_campaign_evolved'}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:Loc Key='setup.launch_the_game_and_enter_an_offline_camp_410753'}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" Click="OnLaunchGame" Content="{i18n:Loc Key='setup.launch_game'}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="10">
                        <SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Setting" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{i18n:Loc Key='setup.2_install_the_live_tools_bridge'}" />
                        <TextBlock x:Name="BridgeStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:Loc Key='setup.checking_installation'}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="RecheckBridgeButton"
                            VerticalAlignment="Center"
                            Click="OnRecheckBridge"
                            Content="{i18n:Loc Key='common.recheck'}" />
                        <Button
                            x:Name="InstallButton"
                            VerticalAlignment="Center"
                            Click="OnInstall"
                            Content="{i18n:Loc Key='setup.install_repair'}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="10">
                        <SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Link" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{i18n:Loc Key='setup.3_connect_to_the_running_mission'}" />
                        <TextBlock x:Name="GameStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:Loc Key='setup.checking_game_session'}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ConnectButton" Grid.Column="2" VerticalAlignment="Center" Click="OnConnect" Style="{StaticResource AccentButtonStyle}" Content="{i18n:Loc Key='setup.connect'}" />
                </Grid>
            </Border>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Severity="Informational"
                Title="{i18n:Loc Key='setup.two_complementary_connections'}"
                Message="{i18n:Loc Key='setup.connect_gives_halo_meister_direct_access_c9b314'}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Click="OnOpenLiveTools" Content="{i18n:Loc Key='setup.continue_to_live_tools'}" Style="{StaticResource AccentButtonStyle}" />
                <Button Click="OnOpenHelp" Content="{i18n:Loc Key='setup.open_setup_guide'}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
