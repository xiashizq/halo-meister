<Page
    x:Class="HaloMeister.App.Pages.CustomizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:Loc Key='customization.loadout_customization'}" />
                <TextBlock
                    MaxWidth="780"
                    HorizontalAlignment="Left"
                    Opacity="0.72"
                    TextWrapping="Wrap"
                    Text="{i18n:Loc Key='customization.choose_an_owned_armor_or_weapon_appearanc_4cce75'}" />
            </StackPanel>
            <StackPanel Grid.Column="1" MinWidth="280" Spacing="5">
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{i18n:Loc Key='customization.game_profile'}" />
                <ComboBox
                    x:Name="ProfilePicker"
                    DisplayMemberPath="DisplayName"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnProfileChanged" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="SafetyNotice"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational"
            Title="{i18n:Loc Key='customization.local_equipped_cosmetics'}"
            Message="{i18n:Loc Key='customization.close_campaign_evolved_before_saving_halo_13192e'}" />

        <CommandBar Grid.Row="2" DefaultLabelPosition="Right">
            <CommandBar.Content>
                <TextBlock
                    x:Name="DirtyText"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="{i18n:Loc Key='customization.no_unsaved_changes'}" />
            </CommandBar.Content>
            <AppBarButton
                x:Name="SaveButton"
                Click="OnSave"
                Icon="Save"
                IsEnabled="False"
                Label="{i18n:Loc Key='customization.save_changes'}" />
            <AppBarButton Click="OnReload" Icon="Refresh" Label="{i18n:Loc Key='customization.reload_profile'}" />
            <AppBarButton Click="OnResetSlot" Icon="Undo" Label="{i18n:Loc Key='customization.reset_selected'}" />
            <AppBarSeparator />
            <AppBarButton Click="OnOpenConfigFolder" Icon="OpenFile" Label="{i18n:Loc Key='customization.open_config_folder'}" />
        </CommandBar>

        <Grid Grid.Row="3" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:Loc Key='customization.equipment_slots'}" />
                            <TextBlock x:Name="OverrideCountText" Opacity="0.62" Text="{i18n:Loc Key='customization.0_local_overrides'}" />
                        </StackPanel>
                        <ProgressRing
                            x:Name="LoadingRing"
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            IsActive="False" />
                    </Grid>

                    <ListView
                        x:Name="SlotList"
                        Grid.Row="1"
                        SelectionChanged="OnSlotSelected"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="70" Padding="2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="92"
                                        Height="58"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <Grid>
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="22"
                                                Glyph="&#xE790;"
                                                Opacity="0.2" />
                                            <Image Source="{Binding SelectedImageUri}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{Binding Name}" />
                                        <TextBlock
                                            Opacity="0.65"
                                            Text="{Binding SelectedName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Opacity="0.5"
                                            Text="{Binding Group}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel MaxWidth="920" Spacing="14">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <Border
                                Height="300"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="10">
                                <Grid>
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="54"
                                        Glyph="&#xE790;"
                                        Opacity="0.14" />
                                    <Image
                                        x:Name="HeroImage"
                                        Source="{x:Null}"
                                        Stretch="Uniform" />
                                    <Rectangle
                                        VerticalAlignment="Bottom"
                                        Height="110">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Offset="0" Color="Transparent" />
                                                <GradientStop Offset="1" Color="#B3000000" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <StackPanel
                                        Margin="22"
                                        VerticalAlignment="Bottom"
                                        Spacing="2">
                                        <TextBlock
                                            x:Name="SlotTitleText"
                                            Foreground="White"
                                            Style="{ThemeResource TitleTextBlockStyle}"
                                            Text="{i18n:Loc Key='customization.select_a_slot'}" />
                                        <TextBlock
                                            x:Name="SlotGroupText"
                                            Foreground="#CCFFFFFF"
                                            Text="{i18n:Loc Key='customization.choose_armor_or_a_weapon_from_the_list'}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:Loc Key='customization.equipped_appearance'}" />
                            <ComboBox
                                x:Name="DetailsChoiceCombo"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnChoiceChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="500" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="78"
                                                Height="48"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="5">
                                                <Image Source="{Binding ImageUri}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{Binding Name}" />
                                                <TextBlock FontSize="12" Opacity="0.65" Text="{Binding Availability}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Opacity="0.65" Text="{i18n:Loc Key='customization.gameplay_tag'}" />
                                <TextBlock
                                    x:Name="SelectedTagText"
                                    Grid.Column="1"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Margin="0,8,0,0" Opacity="0.65" Text="{i18n:Loc Key='customization.availability'}" />
                                <TextBlock
                                    x:Name="AvailabilityText"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <InfoBar
                        x:Name="PageStatus"
                        IsClosable="True"
                        IsOpen="False" />
                    <TextBlock
                        x:Name="ConfigPathText"
                        FontFamily="Consolas"
                        FontSize="11"
                        Opacity="0.5"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
