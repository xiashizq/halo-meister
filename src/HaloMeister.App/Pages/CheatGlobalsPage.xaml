<Page
    x:Class="HaloMeister.App.Pages.CheatGlobalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HaloMeister.App.Controls"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid Padding="28,20,28,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Padding="14,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SymbolIcon
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Symbol="Link" />
                <TextBlock
                    x:Name="BridgeStatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <ProgressRing
                    x:Name="BusyRing"
                    Grid.Column="2"
                    Width="20"
                    Height="20"
                    IsActive="False" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer
                x:Name="QuickCheatsPanel"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,2,12,18" Spacing="14">

                    <!-- 任务作弊 -->
                    <Border Padding="18,14,18,16" Style="{StaticResource LiveToolCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE945;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{i18n:Loc Key='cheat_globals.mission_cheats'}" />
                                    <TextBlock
                                        x:Name="CheatsCountText"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="RefreshButton"
                                        Click="OnRefresh"
                                        Content="{i18n:Loc Key='cheat_globals.load_cheats'}"
                                        IsEnabled="False" />
                                    <Button
                                        x:Name="DisableAllButton"
                                        Click="OnDisableAll"
                                        Content="{i18n:Loc Key='cheat_globals.turn_all_off'}"
                                        IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl x:Name="GlobalsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:UniformColumnPanel
                                            MaxColumns="4"
                                            MinColumnWidth="230"
                                            ColumnSpacing="10"
                                            RowSpacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="48" Padding="14,6,10,6" Style="{StaticResource LiveToolInsetStyle}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <ToggleSwitch
                                                    Grid.Column="1"
                                                    MinWidth="0"
                                                    Margin="0,0,-6,0"
                                                    VerticalAlignment="Center"
                                                    IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                    OffContent=""
                                                    OnContent=""
                                                    Toggled="OnGlobalToggled" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 玩家特性 -->
                    <Border
                        x:Name="PlayerTraitsHeader"
                        Padding="18,14,18,16"
                        Style="{StaticResource LiveToolCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE77B;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{i18n:Loc Key='cheat_globals.player_traits'}" />
                                    <TextBlock
                                        x:Name="TraitsCountText"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="RefreshModifiersButton"
                                        Click="OnRefreshModifiers"
                                        Content="{i18n:Loc Key='cheat_globals.load_traits'}" />
                                    <Button
                                        x:Name="RestoreModifiersButton"
                                        Click="OnRestoreModifiers"
                                        Content="{i18n:Loc Key='cheat_globals.restore_changes'}"
                                        IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl x:Name="ModifierList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:UniformColumnPanel
                                            MaxColumns="4"
                                            MinColumnWidth="230"
                                            ColumnSpacing="10"
                                            RowSpacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,10,14,12" Style="{StaticResource LiveToolInsetStyle}">
                                            <StackPanel Spacing="6">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <ComboBox
                                                    HorizontalAlignment="Stretch"
                                                    DisplayMemberPath="Label"
                                                    ItemsSource="{Binding Options}"
                                                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                    SelectionChanged="OnModifierChanged" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 战斗 -->
                    <Border Padding="18,14,18,16" Style="{StaticResource LiveToolCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE7C9;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{i18n:Loc Key='player_tools.combat'}" />
                            </StackPanel>
                            <controls:UniformColumnPanel
                                MaxColumns="4"
                                MinColumnWidth="230"
                                ColumnSpacing="10"
                                RowSpacing="10">
                                <Border MinHeight="48" Padding="14,6,10,6" Style="{StaticResource LiveToolInsetStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{i18n:Loc Key='player_tools.weapon_animation_interruption'}"
                                            TextTrimming="CharacterEllipsis" />
                                        <ToggleSwitch
                                            x:Name="ImmediateWeaponInterruptionToggle"
                                            Grid.Column="1"
                                            MinWidth="0"
                                            Margin="0,0,-6,0"
                                            VerticalAlignment="Center"
                                            IsOn="False"
                                            OffContent=""
                                            OnContent=""
                                            Toggled="OnWeaponInterruptionToggled" />
                                    </Grid>
                                </Border>
                                <Border
                                    controls:UniformColumnPanel.ColumnSpan="2"
                                    Padding="14,10,14,12"
                                    Style="{StaticResource LiveToolInsetStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{i18n:Loc Key='player_tools.super_punch'}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                x:Name="SuperPunchStrengthBox"
                                                HorizontalAlignment="Stretch"
                                                SelectedIndex="2">
                                                <ComboBoxItem Content="{i18n:Loc Key='player_tools.10_strong'}" Tag="10" />
                                                <ComboBoxItem Content="{i18n:Loc Key='player_tools.25_huge'}" Tag="25" />
                                                <ComboBoxItem Content="{i18n:Loc Key='player_tools.50_across_the_map'}" Tag="50" />
                                                <ComboBoxItem Content="{i18n:Loc Key='player_tools.100_ridiculous'}" Tag="100" />
                                            </ComboBox>
                                            <Button
                                                x:Name="EnableSuperPunchButton"
                                                Grid.Column="1"
                                                Click="OnEnableSuperPunch"
                                                Content="{i18n:Loc Key='player_tools.enable_super_punch'}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                            <Button
                                                x:Name="RestoreSuperPunchButton"
                                                Grid.Column="2"
                                                Click="OnRestoreSuperPunch"
                                                Content="{i18n:Loc Key='player_tools.restore_normal_punch'}"
                                                IsEnabled="False" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </controls:UniformColumnPanel>
                        </StackPanel>
                    </Border>

                    <!-- 其他 -->
                    <Border Padding="18,14,18,16" Style="{StaticResource LiveToolCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE712;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{i18n:Loc Key='other_gameplay.title'}" />
                            </StackPanel>
                            <ItemsControl x:Name="OtherFeaturesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:UniformColumnPanel
                                            MaxColumns="4"
                                            MinColumnWidth="230"
                                            ColumnSpacing="10"
                                            RowSpacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="48" Padding="14,6,8,6" Style="{StaticResource LiveToolInsetStyle}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Click="OnRunOtherFeature"
                                                    Content="{Binding ActionLabel}"
                                                    IsEnabled="{Binding IsEnabled}"
                                                    Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="AllegiancePanel"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel Padding="0,4,0,18" Spacing="14">
                    <Border Padding="18,16" Style="{StaticResource LiveToolCardStyle}">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{i18n:Loc Key='cheat_globals.player_allegiance'}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{i18n:Loc Key='cheat_globals.temporarily_change_which_campaign_faction_57126c'}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="PlayerTeamComboBox"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Label"
                                    IsEnabled="False"
                                    PlaceholderText="{i18n:Loc Key='cheat_globals.load_current_allegiance'}"
                                    SelectionChanged="OnPlayerTeamChanged" />
                                <Button
                                    x:Name="LoadPlayerTeamButton"
                                    Grid.Column="1"
                                    Click="OnLoadPlayerTeam"
                                    Content="{i18n:Loc Key='cheat_globals.load_current'}" />
                                <Button
                                    x:Name="RestorePlayerTeamButton"
                                    Grid.Column="2"
                                    Click="OnRestorePlayerTeam"
                                    Content="{i18n:Loc Key='cheat_globals.restore_original'}"
                                    IsEnabled="False" />
                            </Grid>

                            <Border Style="{StaticResource LiveToolInsetStyle}">
                                <StackPanel Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="{i18n:Loc Key='cheat_globals.what_this_selection_does'}" />
                                    <TextBlock
                                        x:Name="PlayerTeamDescriptionText"
                                        Style="{StaticResource CompactSafetyTextStyle}"
                                        Text="{i18n:Loc Key='cheat_globals.load_the_controlled_player_s_current_alle_09bc42'}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource LiveToolInsetStyle}">
                        <TextBlock
                            Style="{StaticResource CompactSafetyTextStyle}"
                            Text="{i18n:Loc Key='cheat_globals.allegiance_applies_only_to_the_current_pl_77e9dd'}" />
                    </Border>

                    <Border Padding="18,16" Style="{StaticResource LiveToolCardStyle}">
                        <StackPanel Spacing="18">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{i18n:Loc Key='cheat_globals.global_allegiance_title'}" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="GlobalAllegianceTeamComboBox"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Label"
                                    IsEnabled="False"
                                    PlaceholderText="{i18n:Loc Key='cheat_globals.global_allegiance_choose_team'}" />
                                <Button
                                    x:Name="GlobalAllegianceAllyButton"
                                    Grid.Column="1"
                                    Click="OnGlobalAllegianceAlly"
                                    Content="{i18n:Loc Key='cheat_globals.global_allegiance_submit'}"
                                    IsEnabled="False" />
                                <Button
                                    x:Name="GlobalAllegianceBreakButton"
                                    Grid.Column="2"
                                    Click="OnGlobalAllegianceBreak"
                                    Content="{i18n:Loc Key='cheat_globals.global_allegiance_break'}"
                                    IsEnabled="False" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Padding="14,10" Style="{StaticResource LiveToolInsetStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="SummaryText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{i18n:Loc Key='cheat_globals.load_an_offline_campaign_mission_then_cho_e859a5'}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Page>
