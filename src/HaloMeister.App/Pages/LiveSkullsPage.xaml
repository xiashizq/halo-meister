<Page
    x:Class="HaloMeister.App.Pages.LiveSkullsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:Loc Key='live_skulls.live_skulls'}" />
            <TextBlock
                Style="{StaticResource LivePageDescriptionStyle}"
                Text="{i18n:Loc Key='live_skulls.enable_or_disable_the_simulation_s_56_sku_b96ae8'}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="BridgeStatusText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="FilterBox"
                Grid.Column="1"
                PlaceholderText="{i18n:Loc Key='live_skulls.filter_skulls'}"
                TextChanged="OnFilterChanged" />
            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                Click="OnRefresh"
                Content="{i18n:Loc Key='live_skulls.refresh'}"
                IsEnabled="False" />
            <Button
                x:Name="DisableAllButton"
                Grid.Column="3"
                Click="OnDisableAll"
                Content="{i18n:Loc Key='live_skulls.turn_all_off'}"
                IsEnabled="False" />
        </Grid>

        <ListView
            x:Name="SkullsList"
            Grid.Row="2"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,10" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="56"
                            Height="56"
                            Padding="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <Image Source="{Binding IconUri}" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding DisplayName}" />
                            <TextBlock
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding Detail}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            IsOn="{Binding IsEnabled, Mode=TwoWay}"
                            OffContent="{i18n:Loc Key='live_skulls.off'}"
                            OnContent="{i18n:Loc Key='live_skulls.on'}"
                            Toggled="OnSkullToggled" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
            <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" />
            <TextBlock
                x:Name="SummaryText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{i18n:Loc Key='live_skulls.load_an_offline_campaign_mission_then_ref_ed7365'}" />
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="4" IsOpen="False" />
    </Grid>
</Page>
