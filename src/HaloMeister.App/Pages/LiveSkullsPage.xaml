<Page
    x:Class="HaloMeister.App.Pages.LiveSkullsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid Padding="24,16,24,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, description, bridge status, actions -->
        <Border Style="{StaticResource LiveToolCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{i18n:Loc Key='live_skulls.page_title'}" />
                    <TextBlock
                        Style="{StaticResource LivePageDescriptionStyle}"
                        Text="{i18n:Loc Key='live_skulls.page_subtitle'}" />
                    <StackPanel
                        Margin="0,6,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE702;" />
                        <TextBlock
                            x:Name="BridgeStatusText"
                            Style="{StaticResource CompactSafetyTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Top">
                    <Button
                        x:Name="RefreshButton"
                        Click="OnRefresh"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="{i18n:Loc Key='live_skulls.refresh'}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="DisableAllButton"
                        Click="OnDisableAll"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE7E8;" />
                            <TextBlock Text="{i18n:Loc Key='live_skulls.turn_all_off'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="FilterBox"
                PlaceholderText="{i18n:Loc Key='live_skulls.filter_skulls'}"
                QueryIcon="Find"
                TextChanged="OnFilterChanged" />
            <ComboBox
                x:Name="CategoryBox"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnCategoryChanged" />
            <ToggleButton
                x:Name="EnabledOnlyToggle"
                Grid.Column="2"
                Checked="OnEnabledOnlyChanged"
                Content="{i18n:Loc Key='live_skulls.filter_enabled'}"
                Unchecked="OnEnabledOnlyChanged" />
        </Grid>

        <!-- Skull list -->
        <Grid Grid.Row="2">
            <ListView
                x:Name="SkullsList"
                IsItemClickEnabled="False"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,12" Style="{StaticResource LiveToolCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="64"
                                    Height="64"
                                    Padding="6"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource LiveToolInsetStyle}">
                                    <Image Source="{Binding IconUri}" Stretch="Uniform" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="5"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding EnglishName}"
                                            Visibility="{Binding EnglishNameVisibility}" />
                                        <Border
                                            Padding="8,1"
                                            VerticalAlignment="Center"
                                            Background="{Binding CategoryFill}"
                                            CornerRadius="10">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{Binding CategoryForeground}"
                                                Text="{Binding CategoryLabel}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Opacity="0.9"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Detail}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                    OffContent="{i18n:Loc Key='live_skulls.off'}"
                                    OnContent="{i18n:Loc Key='live_skulls.on'}"
                                    Toggled="OnSkullToggled" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE721;"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="EmptyText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Footer: summary and sources -->
        <StackPanel Grid.Row="3" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" />
                <TextBlock
                    x:Name="SummaryText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{i18n:Loc Key='live_skulls.load_an_offline_campaign_mission_then_ref_ed7365'}" />
            </StackPanel>
            <TextBlock
                Style="{StaticResource CompactSafetyTextStyle}"
                Text="{i18n:Loc Key='live_skulls.source_note'}" />
        </StackPanel>
    </Grid>
</Page>
