<Page
    x:Class="HaloMeister.App.Pages.ScenarioPropsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{i18n:Loc Key='scenario_props.title'}" />
                <TextBlock
                    Style="{StaticResource LivePageDescriptionStyle}"
                    Text="{i18n:Loc Key='scenario_props.description'}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="RefreshButton"
                    Click="OnRefresh"
                    Content="{i18n:Loc Key='scenario_props.refresh'}"
                    IsEnabled="False" />
                <Button
                    x:Name="ScanButton"
                    Click="OnScan"
                    Content="{i18n:Loc Key='scenario_props.scan'}"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing
                    x:Name="BusyRing"
                    Width="22"
                    Height="22"
                    IsActive="False" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Padding="12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{i18n:Loc Key='scenario_props.list_title'}" />
                        <TextBlock
                            x:Name="CountText"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='scenario_props.not_scanned'}" />
                    </Grid>
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Row="1"
                        IsEnabled="False"
                        PlaceholderText="{i18n:Loc Key='scenario_props.search_placeholder'}"
                        TextChanged="OnSearchChanged" />
                    <ListView
                        x:Name="GroupList"
                        Grid.Row="2"
                        SelectionChanged="OnGroupSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,7" Spacing="3">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Detail}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <StackPanel
                        x:Name="EmptyState"
                        Width="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="38"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE890;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{i18n:Loc Key='scenario_props.choose_group'}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='scenario_props.choose_group_hint'}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid
                        x:Name="SelectionDetails"
                        Padding="20"
                        RowSpacing="12"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="SelectedGroupText"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="SelectedGroupDetailText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ListView
                            x:Name="PlacementList"
                            Grid.Row="1"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding ScriptName}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding PositionDisplay}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Click="OnHidePlacement"
                                            Content="{i18n:Loc Key='scenario_props.hide'}"
                                            Tag="{Binding}" />
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Click="OnShowPlacement"
                                            Content="{i18n:Loc Key='scenario_props.show'}"
                                            Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="HideGroupButton"
                                Click="OnHideGroup"
                                Content="{i18n:Loc Key='scenario_props.hide_group'}"
                                IsEnabled="False" />
                            <Button
                                x:Name="ShowGroupButton"
                                Click="OnShowGroup"
                                Content="{i18n:Loc Key='scenario_props.show_group'}"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock
                x:Name="ConnectionText"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar
                x:Name="StatusBar"
                IsClosable="True"
                IsOpen="False" />
        </StackPanel>
    </Grid>
</Page>
