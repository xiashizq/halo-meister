<UserControl
    x:Class="HaloMeister.App.Pages.CharacterModelPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SideColumn" Width="360" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                x:Name="ViewportHost"
                Background="#FFE4EEF4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <SwapChainPanel
                        x:Name="Viewport"
                        PointerMoved="OnPointerMoved"
                        PointerPressed="OnPointerPressed"
                        PointerReleased="OnPointerReleased"
                        PointerWheelChanged="OnPointerWheel" />
                    <ProgressRing
                        x:Name="BusyRing"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        IsActive="False" />
                    <TextBlock
                        x:Name="MessageText"
                        IsHitTestVisible="False"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#FF3A4A55"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
            <TextBlock
                x:Name="StatsText"
                Grid.Row="1"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <ScrollViewer
                x:Name="SidePanel"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='character_model.variants'}" />
                        <ComboBox
                            x:Name="VariantBox"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="OnVariantChanged" />
                    </StackPanel>
                    <StackPanel x:Name="RegionHost" Spacing="10" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border
            x:Name="PlayerBar"
            Grid.Row="1"
            Padding="12,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{i18n:Loc Key='character_model.player'}" />
                    <ComboBox
                        x:Name="AnimationBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        MaxDropDownHeight="320"
                        DisplayMemberPath="Label"
                        PlaceholderText="{i18n:Loc Key='character_model.animations'}" />
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            x:Name="PlayButton"
                            Width="36"
                            Height="32"
                            Padding="0"
                            Click="OnPlay"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="{i18n:Loc Key='character_model.play'}">
                            <SymbolIcon Symbol="Play" />
                        </Button>
                        <Button
                            x:Name="PauseButton"
                            Width="36"
                            Height="32"
                            Padding="0"
                            Click="OnPause"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="{i18n:Loc Key='character_model.pause'}">
                            <SymbolIcon Symbol="Pause" />
                        </Button>
                        <Button
                            x:Name="StopButton"
                            Width="36"
                            Height="32"
                            Padding="0"
                            Click="OnStop"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="{i18n:Loc Key='character_model.stop'}">
                            <SymbolIcon Symbol="Stop" />
                        </Button>
                        <ToggleButton
                            x:Name="LoopButton"
                            Width="36"
                            Height="32"
                            Padding="0"
                            Click="OnLoop"
                            IsChecked="True"
                            ToolTipService.ToolTip="{i18n:Loc Key='character_model.loop'}">
                            <SymbolIcon Symbol="RepeatAll" />
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='character_model.speed'}" />
                        <ComboBox
                            x:Name="SpeedBox"
                            Width="88"
                            SelectedIndex="2"
                            SelectionChanged="OnSpeedChanged">
                            <ComboBoxItem Content="0.25×" Tag="0.25" />
                            <ComboBoxItem Content="0.50×" Tag="0.5" />
                            <ComboBoxItem Content="1.00×" Tag="1" />
                            <ComboBoxItem Content="1.50×" Tag="1.5" />
                            <ComboBoxItem Content="2.00×" Tag="2" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock
                        x:Name="FrameLabel"
                        Grid.Column="4"
                        MinWidth="72"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Right" />
                </Grid>
                <Slider
                    x:Name="FrameSlider"
                    Grid.Row="1"
                    Maximum="1"
                    Minimum="0"
                    StepFrequency="1"
                    ValueChanged="OnFrameChanged" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
