<Page
    x:Class="HaloMeister.App.Pages.BoundaryVolumesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:Loc Key='boundary_volumes.boundaries'}" />
            <TextBlock
                Style="{StaticResource LivePageDescriptionStyle}"
                Text="{i18n:Loc Key='boundary_volumes.temporarily_disable_mission_boundaries_an_57106c'}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="DisableButton"
                    Click="OnDisable"
                    Content="{i18n:Loc Key='boundary_volumes.disable_all_boundaries'}"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="RestoreButton"
                    Click="OnRestore"
                    Content="{i18n:Loc Key='boundary_volumes.restore_snapshot'}"
                    IsEnabled="False" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    x:Name="ScanButton"
                    Click="OnScan"
                    Content="{i18n:Loc Key='boundary_volumes.scan_boundaries'}"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="RefreshButton"
                    Click="OnRefresh"
                    Content="{i18n:Loc Key='boundary_volumes.refresh'}"
                    IsEnabled="False" />
                <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="14"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock FontWeight="SemiBold" Text="{i18n:Loc Key='boundary_volumes.physical_invisible_walls'}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{i18n:Loc Key='boundary_volumes.physical_walls_hint'}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="PhysicalStatusText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{i18n:Loc Key='boundary_volumes.bridge_status_not_checked'}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="RefreshPhysicalButton"
                    Grid.Column="1"
                    Click="OnRefreshPhysical"
                    Content="{i18n:Loc Key='boundary_volumes.read_state'}"
                    IsEnabled="False" />
                <Button
                    x:Name="DisablePhysicalButton"
                    Grid.Column="2"
                    Click="OnDisablePhysical"
                    Content="{i18n:Loc Key='boundary_volumes.disable_physical_walls'}"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="EnablePhysicalButton"
                    Grid.Column="3"
                    Click="OnEnablePhysical"
                    Content="{i18n:Loc Key='boundary_volumes.restore_physical_walls'}"
                    IsEnabled="False" />
            </Grid>
        </Border>

        <Border
            Grid.Row="3"
            HorizontalAlignment="Stretch"
            Padding="18"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="SummaryText"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{i18n:Loc Key='boundary_volumes.no_runtime_boundary_scan_yet'}" />
                <TextBlock
                    x:Name="DetailText"
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{i18n:Loc Key='boundary_volumes.install_the_bridge_restart_the_game_load_fe0d82'}"
                    TextWrapping="Wrap" />
                <ListView
                    x:Name="ScenarioList"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,8" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontFamily="Consolas"
                                    Text="{i18n:Loc Key='boundary_volumes.active_simulation_thread_bitset'}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding StatusDisplay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <InfoBar x:Name="StatusBar" Grid.Row="4" IsClosable="True" IsOpen="False" />
    </Grid>
</Page>
