<Page
    x:Class="HaloMeister.App.Pages.LiveToolsHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="12,4,12,0"
            Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <NavigationView
                    x:Name="ToolNav"
                    AlwaysShowHeader="False"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Top"
                    SelectionChanged="OnToolSelectionChanged" />
                <TextBlock
                    Grid.Column="1"
                    MaxWidth="220"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{i18n:Loc Key='live_tools_hub.offline_campaign_session_changes'}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{i18n:Loc Key='live_tools_hub.offline_campaign_session_changes'}" />
            </Grid>
        </Border>

        <Frame x:Name="ToolFrame" Grid.Row="1" />
    </Grid>
</Page>
