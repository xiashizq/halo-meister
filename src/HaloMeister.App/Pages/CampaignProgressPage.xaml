<Page
    x:Class="HaloMeister.App.Pages.CampaignProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization"
    xmlns:pages="using:HaloMeister.App.Pages">

    <Grid Padding="28,24,28,28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:Loc Key='campaign_progress.campaign_progress'}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{i18n:Loc Key='campaign_progress.edit_mission_completion_unlocked_skulls_t_10e72f'}" />
        </StackPanel>

        <pages:SaveDataAlert Grid.Row="1" />

        <NavigationView
            x:Name="SectionNav"
            Grid.Row="2"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            SelectionChanged="OnSectionSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="MissionsSection"
                    Content="{i18n:Loc Key='campaign_progress.missions'}"
                    Icon="Map"
                    Tag="missions" />
                <NavigationViewItem
                    Content="{i18n:Loc Key='campaign_progress.skulls'}"
                    Icon="Emoji"
                    Tag="skulls" />
                <NavigationViewItem
                    Content="{i18n:Loc Key='campaign_progress.terminals_checkpoints'}"
                    Icon="Tag"
                    Tag="terminals" />
            </NavigationView.MenuItems>
            <Frame x:Name="SectionFrame" />
        </NavigationView>
    </Grid>
</Page>
