<Page
    x:Class="HaloMeister.App.Pages.SquadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HaloMeister.App.Controls"
    xmlns:i18n="using:HaloMeister.App.Localization">
    <Page.Resources>
        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style
            x:Key="RowAccentButtonStyle"
            BasedOn="{StaticResource AccentButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{i18n:Loc Key='squads.title'}" />
                <TextBlock
                    Style="{StaticResource LivePageDescriptionStyle}"
                    Text="{i18n:Loc Key='squads.description'}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="RefreshButton"
                    Click="OnRefresh"
                    Content="{i18n:Loc Key='squads.refresh'}"
                    IsEnabled="False" />
                <Button
                    x:Name="ScanButton"
                    Click="OnScan"
                    Content="{i18n:Loc Key='squads.scan'}"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing
                    x:Name="BusyRing"
                    Width="22"
                    Height="22"
                    IsActive="False" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid Padding="16,14,16,12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE716;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{i18n:Loc Key='squads.list_title'}" />
                    </StackPanel>
                    <Border
                        Padding="10,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <TextBlock
                            x:Name="CountText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='squads.not_scanned'}" />
                    </Border>
                </Grid>
                <TextBox
                    x:Name="SearchBox"
                    Grid.Row="1"
                    CornerRadius="6"
                    IsEnabled="False"
                    PlaceholderText="{i18n:Loc Key='squads.search_placeholder'}"
                    TextChanged="OnSearchChanged" />
                <ListView
                    x:Name="SquadList"
                    Grid.Row="2"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="12,8"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{Binding ListTitle}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding TeamDisplay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Button
                                            Click="OnPlace"
                                            Content="{i18n:Loc Key='squads.place'}"
                                            IsEnabled="{Binding CanAct}"
                                            Style="{StaticResource RowAccentButtonStyle}" />
                                        <Button
                                            Click="OnErase"
                                            Content="{i18n:Loc Key='squads.erase'}"
                                            IsEnabled="{Binding CanAct}"
                                            Style="{StaticResource RowButtonStyle}" />
                                        <Button
                                            Click="OnTeleport"
                                            Content="{i18n:Loc Key='squads.teleport'}"
                                            IsEnabled="{Binding CanTeleport}"
                                            Style="{StaticResource RowButtonStyle}"
                                            ToolTipService.ToolTip="{i18n:Loc Key='squads.teleport_tooltip'}" />
                                        <Button
                                            Click="OnInvincible"
                                            Content="{i18n:Loc Key='squads.invincible'}"
                                            IsEnabled="{Binding CanAct}"
                                            Style="{StaticResource RowButtonStyle}" />
                                        <Button
                                            Click="OnMortal"
                                            Content="{i18n:Loc Key='squads.invincible_off'}"
                                            IsEnabled="{Binding CanAct}"
                                            Style="{StaticResource RowButtonStyle}" />
                                        <Button
                                            Click="OnAlly"
                                            Content="{i18n:Loc Key='squads.ally'}"
                                            IsEnabled="{Binding CanAct}"
                                            Style="{StaticResource RowButtonStyle}" />
                                        <Button
                                            Click="OnHostile"
                                            Content="{i18n:Loc Key='squads.hostile'}"
                                            IsEnabled="{Binding CanAct}"
                                            Style="{StaticResource RowButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock
                x:Name="ConnectionText"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
