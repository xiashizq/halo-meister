<Page
    x:Class="HaloMeister.App.Pages.CharacterModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization"
    xmlns:pages="using:HaloMeister.App.Pages">

    <Grid Padding="24,12,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button
                x:Name="RefreshButton"
                Click="OnRefresh"
                Content="{i18n:Loc Key='character_model.refresh'}" />
            <ProgressRing
                x:Name="BusyRing"
                Width="18"
                Height="18"
                IsActive="False"
                VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="12,10,12,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{i18n:Loc Key='character_model.categories'}" />
                    <ListView
                        x:Name="CategoryList"
                        Grid.Row="1"
                        Padding="4"
                        SelectionChanged="OnCategorySelected"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Padding="4,8"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ComboBox
                    x:Name="ModelBox"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Name"
                    MaxDropDownHeight="420"
                    PlaceholderText="{i18n:Loc Key='character_model.files'}"
                    SelectionChanged="OnModelChanged" />
                <Grid Grid.Row="1">
                    <pages:CharacterModelPreviewWindow x:Name="Preview" />
                    <StackPanel
                        x:Name="EmptyState"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B9;" />
                        <TextBlock
                            x:Name="EmptyTitle"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{i18n:Loc Key='character_model.empty_title'}"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="EmptyHint"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='character_model.empty_hint'}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
