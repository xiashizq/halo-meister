<Page
    x:Class="HaloMeister.App.Pages.AllegianceDemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Page.Resources>
        <SolidColorBrush x:Key="FriendlyBrush" Color="#4CAF78" />
        <SolidColorBrush x:Key="HostileBrush" Color="#E05656" />
        <SolidColorBrush x:Key="WarningBrush" Color="#E0A83C" />
        <SolidColorBrush x:Key="IdleBrush" Color="#808080" />
        <SolidColorBrush x:Key="FriendlyChipBrush" Color="#334CAF78" />
        <SolidColorBrush x:Key="HostileChipBrush" Color="#33E05656" />

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChipBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style
            x:Key="RowAccentButtonStyle"
            BasedOn="{StaticResource AccentButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,20,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{i18n:Loc Key='allegiance_demo.title'}" />
                <TextBlock
                    MaxLines="1"
                    Style="{StaticResource CompactSafetyTextStyle}"
                    Text="{i18n:Loc Key='allegiance_demo.description'}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Padding="10,4"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            x:Name="StatusDot"
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            x:Name="BridgeStatusText"
                            MaxWidth="260"
                            VerticalAlignment="Center"
                            Style="{StaticResource CompactSafetyTextStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>
                <ProgressRing
                    x:Name="BusyRing"
                    Width="18"
                    Height="18"
                    IsActive="False" />
            </StackPanel>
            <Button
                x:Name="ScanButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="OnScan"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="{i18n:Loc Key='allegiance_demo.scan'}" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Name="ModRequiredBanner"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Message="{i18n:Loc Key='allegiance_demo.mod_required_body'}"
            Severity="Warning"
            Title="{i18n:Loc Key='allegiance_demo.mod_required_title'}">
            <InfoBar.ActionButton>
                <Button
                    Click="OnOpenBuiltinMod"
                    Content="{i18n:Loc Key='allegiance_demo.open_builtin_mod'}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid
            x:Name="WorkspacePanel"
            Grid.Row="2"
            ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="300" />
                <ColumnDefinition Width="1.5*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Left: catalog -->
            <Border Padding="16,14" Style="{StaticResource LiveToolCardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE716;" />
                            <TextBlock
                                Style="{StaticResource CardTitleStyle}"
                                Text="{i18n:Loc Key='allegiance_demo.catalog_title'}" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            Style="{StaticResource ChipBorderStyle}">
                            <TextBlock
                                x:Name="CatalogCountText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="0" />
                        </Border>
                    </Grid>

                    <TextBox
                        x:Name="CharacterFilterBox"
                        Grid.Row="1"
                        CornerRadius="6"
                        PlaceholderText="{i18n:Loc Key='allegiance_demo.filter_characters'}"
                        TextChanged="OnCharacterFilterChanged" />

                    <Grid Grid.Row="2">
                        <ListView
                            x:Name="CharacterList"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10,7"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        CornerRadius="8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="32"
                                                Height="32"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="16">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Glyph="&#xE77B;" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{Binding DisplayName}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{Binding DisplayName}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding SecondaryName}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{Binding SecondaryNameVisibility}" />
                                                </Grid>
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Category}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{Binding Category}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Button
                                                    Click="OnAddFriendly"
                                                    Content="{i18n:Loc Key='allegiance_demo.add_friendly'}"
                                                    Style="{StaticResource RowAccentButtonStyle}" />
                                                <Button
                                                    Click="OnAddHostile"
                                                    Content="{i18n:Loc Key='allegiance_demo.add_hostile'}"
                                                    Style="{StaticResource RowButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel
                            x:Name="EmptyCatalogPanel"
                            Margin="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE721;" />
                            <TextBlock
                                x:Name="EmptyCatalogText"
                                MaxWidth="280"
                                HorizontalAlignment="Center"
                                Style="{StaticResource CompactSafetyTextStyle}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: roster -->
            <Border
                Grid.Column="1"
                Padding="16,14"
                Style="{StaticResource LiveToolCardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE902;" />
                            <TextBlock
                                Style="{StaticResource CardTitleStyle}"
                                Text="{i18n:Loc Key='allegiance_demo.roster_title'}" />
                            <Border Background="{StaticResource FriendlyChipBrush}" Style="{StaticResource ChipBorderStyle}">
                                <TextBlock
                                    x:Name="FriendlyChipText"
                                    FontSize="12"
                                    Foreground="{StaticResource FriendlyBrush}" />
                            </Border>
                            <Border Background="{StaticResource HostileChipBrush}" Style="{StaticResource ChipBorderStyle}">
                                <TextBlock
                                    x:Name="HostileChipText"
                                    FontSize="12"
                                    Foreground="{StaticResource HostileBrush}" />
                            </Border>
                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" Style="{StaticResource ChipBorderStyle}">
                                <TextBlock
                                    x:Name="TotalChipText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <Button
                            x:Name="RecallSettingsButton"
                            Grid.Column="1"
                            Click="OnRecallSettings"
                            Content="{i18n:Loc Key='allegiance_demo.recall_settings'}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="{i18n:Loc Key='allegiance_demo.recall_settings_tooltip'}" />
                        <Button
                            x:Name="RecallButton"
                            Grid.Column="2"
                            Click="OnRecallBots"
                            Content="{i18n:Loc Key='allegiance_demo.recall'}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="{i18n:Loc Key='allegiance_demo.recall_tooltip'}" />
                        <Button
                            x:Name="ClearSquadButton"
                            Grid.Column="3"
                            Click="OnClearSquad"
                            Content="{i18n:Loc Key='allegiance_demo.clear_squad'}"
                            IsEnabled="False" />
                        <Button
                            x:Name="SpawnSquadButton"
                            Grid.Column="4"
                            MinWidth="132"
                            Click="OnSpawnSquad"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="Play" />
                                <TextBlock Text="{i18n:Loc Key='allegiance_demo.spawn_squad'}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView
                            x:Name="SquadList"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        CornerRadius="8">
                                        <Grid ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Background="{Binding TeamBrush}"
                                                CornerRadius="8,0,0,8" />
                                            <Grid
                                                Grid.Column="1"
                                                Padding="12,8,10,10"
                                                RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="{Binding DisplayName}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTipService.ToolTip="{Binding DisplayName}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding SecondaryName}"
                                                                TextTrimming="CharacterEllipsis"
                                                                Visibility="{Binding SecondaryNameVisibility}" />
                                                        </Grid>
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Category}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <ComboBox
                                                        Grid.Column="1"
                                                        Width="96"
                                                        VerticalAlignment="Center"
                                                        DisplayMemberPath="Label"
                                                        ItemsSource="{Binding TeamChoices}"
                                                        SelectedItem="{Binding SelectedTeam, Mode=TwoWay}"
                                                        ToolTipService.ToolTip="{i18n:Loc Key='allegiance_demo.choose_team'}" />
                                                    <NumberBox
                                                        Grid.Column="2"
                                                        Width="148"
                                                        MinWidth="148"
                                                        VerticalAlignment="Center"
                                                        LargeChange="5"
                                                        Maximum="50"
                                                        Minimum="1"
                                                        SmallChange="1"
                                                        SpinButtonPlacementMode="Inline"
                                                        ToolTipService.ToolTip="{i18n:Loc Key='allegiance_demo.quantity'}"
                                                        Value="{Binding QuantityValue, Mode=TwoWay}" />
                                                    <Button
                                                        Grid.Column="3"
                                                        Width="34"
                                                        Height="32"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        Click="OnRemoveRow"
                                                        ToolTipService.ToolTip="{i18n:Loc Key='allegiance_demo.remove_row'}">
                                                        <SymbolIcon Symbol="Delete" />
                                                    </Button>
                                                </Grid>

                                                <Grid Grid.Row="1" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox
                                                        MinWidth="0"
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Name"
                                                        Header="{i18n:Loc Key='allegiance_demo.character_variant'}"
                                                        IsEnabled="{Binding CanSelectVariant}"
                                                        ItemsSource="{Binding VariantChoices}"
                                                        SelectedItem="{Binding SelectedVariant, Mode=TwoWay}" />
                                                    <ComboBox
                                                        Grid.Column="1"
                                                        MinWidth="0"
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Label"
                                                        Header="{i18n:Loc Key='allegiance_demo.weapon'}"
                                                        ItemsSource="{Binding WeaponChoices}"
                                                        SelectedItem="{Binding SelectedWeapon, Mode=TwoWay}" />
                                                    <ComboBox
                                                        Grid.Column="2"
                                                        MinWidth="0"
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="Label"
                                                        Header="{i18n:Loc Key='allegiance_demo.weapon_variant'}"
                                                        IsEnabled="{Binding CanSelectWeaponVariant}"
                                                        ItemsSource="{Binding WeaponVariantChoices}"
                                                        SelectedItem="{Binding SelectedWeaponVariant, Mode=TwoWay}" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel
                            x:Name="EmptySquadPanel"
                            Margin="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE902;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource CompactSafetyTextStyle}"
                                Text="{i18n:Loc Key='allegiance_demo.no_squad_members'}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        x:Name="SpawnSummaryText"
                        Grid.Row="2"
                        Style="{StaticResource CompactSafetyTextStyle}" />
                </Grid>
            </Border>
        </Grid>

        <Expander
            x:Name="AdvancedExpander"
            Grid.Row="3"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Header="{i18n:Loc Key='allegiance_demo.advanced_reinforce'}">
            <Grid Padding="0,8,0,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="ApplyTeamComboBox"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Label"
                    PlaceholderText="{i18n:Loc Key='allegiance_demo.choose_team'}" />
                <Button
                    x:Name="ApplyTeamButton"
                    Grid.Column="1"
                    Click="OnApplyTeam"
                    Content="{i18n:Loc Key='allegiance_demo.apply_object_team'}"
                    IsEnabled="False" />
                <TextBlock
                    x:Name="LastActorText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="12"
                    Opacity="0.78"
                    Text="{i18n:Loc Key='allegiance_demo.no_actor_yet'}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Expander>
    </Grid>
</Page>
