<Page
    x:Class="HaloMeister.App.Pages.AllegianceDemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid Padding="24,24,24,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="5">
            <TextBlock
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{i18n:Loc Key='allegiance_demo.title'}" />
            <TextBlock
                Style="{StaticResource LivePageDescriptionStyle}"
                Text="{i18n:Loc Key='allegiance_demo.description'}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Name="ModRequiredBanner"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning"
                Title="{i18n:Loc Key='allegiance_demo.mod_required_title'}"
                Message="{i18n:Loc Key='allegiance_demo.mod_required_body'}" />
            <Border Style="{StaticResource LiveToolInsetStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="BridgeStatusText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ProgressRing
                        x:Name="BusyRing"
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        IsActive="False" />
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Style="{StaticResource LiveToolCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{i18n:Loc Key='allegiance_demo.step_unit_team'}" />
                        <TextBlock
                            Opacity="0.72"
                            Text="{i18n:Loc Key='allegiance_demo.step_unit_team_hint'}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="TeamComboBox"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Label"
                            PlaceholderText="{i18n:Loc Key='allegiance_demo.choose_team'}" />
                        <Button
                            x:Name="ApplyTeamButton"
                            Click="OnApplyTeam"
                            Content="{i18n:Loc Key='allegiance_demo.apply_object_team'}"
                            IsEnabled="False" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource LiveToolCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{i18n:Loc Key='allegiance_demo.step_spawn'}" />
                        <TextBlock
                            Opacity="0.72"
                            Text="{i18n:Loc Key='allegiance_demo.step_spawn_hint'}"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="CharacterComboBox"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="DisplayName"
                                PlaceholderText="{i18n:Loc Key='allegiance_demo.choose_character'}"
                                SelectionChanged="OnCharacterChanged" />
                            <Button
                                x:Name="ScanButton"
                                Grid.Column="1"
                                Click="OnScan"
                                Content="{i18n:Loc Key='allegiance_demo.scan'}" />
                            <Button
                                x:Name="SpawnButton"
                                Grid.Column="2"
                                Click="OnSpawn"
                                Content="{i18n:Loc Key='allegiance_demo.spawn_ai'}"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                        <TextBlock
                            x:Name="LastActorText"
                            FontFamily="Consolas"
                            Opacity="0.78"
                            Text="{i18n:Loc Key='allegiance_demo.no_actor_yet'}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource LiveToolCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{i18n:Loc Key='allegiance_demo.step_global'}" />
                        <TextBlock
                            Opacity="0.72"
                            Text="{i18n:Loc Key='allegiance_demo.step_global_hint'}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="AllyButton"
                                Click="OnAlly"
                                Content="{i18n:Loc Key='allegiance_demo.hs_allegiance'}"
                                IsEnabled="False" />
                            <Button
                                x:Name="BreakButton"
                                Click="OnBreak"
                                Content="{i18n:Loc Key='allegiance_demo.hs_break'}"
                                IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="3"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
