<Page
    x:Class="HaloMeister.App.Pages.MissionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid Padding="16,12,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:Loc Key='missions.mission_completion'}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{i18n:Loc Key='missions.choose_exactly_which_difficulties_and_cha_a91d20'}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="OnUnlockGates">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE785;" />
                        <TextBlock Text="{i18n:Loc Key='missions.unlock_all_missions'}" />
                    </StackPanel>
                </Button>
                <Button Content="{i18n:Loc Key='missions.bulk_actions'}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="OnCompleteAll" Text="{i18n:Loc Key='missions.mark_every_mission_complete'}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE73E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnClearAll" Text="{i18n:Loc Key='missions.clear_all_completion'}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="12,9"
            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
            CornerRadius="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="14"
                    Glyph="&#xE946;" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Text="{i18n:Loc Key='missions.campaign_difficulties_cascade_selecting_a_37bcae'}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Padding="16,10"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{i18n:Loc Key='missions.missions'}" />
                        <Border
                            Padding="7,1"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="9">
                            <TextBlock FontSize="11" Text="14" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{i18n:Loc Key='missions.easy'}" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{i18n:Loc Key='missions.normal'}" />
                    <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{i18n:Loc Key='missions.heroic'}" />
                    <TextBlock Grid.Column="4" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{i18n:Loc Key='missions.legendary'}" />
                    <TextBlock Grid.Column="5" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{i18n:Loc Key='missions.laso'}" />
                    <TextBlock Grid.Column="6" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{i18n:Loc Key='missions.remix'}" />
                    <TextBlock Grid.Column="7" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{i18n:Loc Key='missions.deathless'}" />
                </Grid>

                <ListView
                    x:Name="MissionList"
                    Grid.Row="1"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="8,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="10,7"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                CornerRadius="7">
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Text="{Binding Code}" />
                                    </StackPanel>

                                    <CheckBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Center" IsChecked="{Binding Easy.IsSet, Mode=TwoWay}" ToolTipService.ToolTip="{i18n:Loc Key='missions.easy_complete'}" />
                                    <CheckBox Grid.Column="2" MinWidth="0" HorizontalAlignment="Center" IsChecked="{Binding Normal.IsSet, Mode=TwoWay}" ToolTipService.ToolTip="{i18n:Loc Key='missions.normal_complete'}" />
                                    <CheckBox Grid.Column="3" MinWidth="0" HorizontalAlignment="Center" IsChecked="{Binding Heroic.IsSet, Mode=TwoWay}" ToolTipService.ToolTip="{i18n:Loc Key='missions.heroic_complete'}" />
                                    <CheckBox Grid.Column="4" MinWidth="0" HorizontalAlignment="Center" IsChecked="{Binding Legendary.IsSet, Mode=TwoWay}" ToolTipService.ToolTip="{i18n:Loc Key='missions.legendary_complete'}" />
                                    <CheckBox Grid.Column="5" MinWidth="0" HorizontalAlignment="Center" IsChecked="{Binding Laso.IsSet, Mode=TwoWay}" ToolTipService.ToolTip="{i18n:Loc Key='missions.laso_complete'}" />
                                    <CheckBox Grid.Column="6" MinWidth="0" HorizontalAlignment="Center" IsChecked="{Binding Remix.IsSet, Mode=TwoWay}" ToolTipService.ToolTip="{i18n:Loc Key='missions.remix_complete'}" />
                                    <CheckBox Grid.Column="7" MinWidth="0" HorizontalAlignment="Center" IsChecked="{Binding Deathless.IsSet, Mode=TwoWay}" ToolTipService.ToolTip="{i18n:Loc Key='missions.remix_deathless_complete'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
