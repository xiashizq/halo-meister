<Page
    x:Class="HaloMeister.App.Pages.CinematicsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{i18n:Loc Key='cinematics.title'}" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="LevelText"
                    MaxWidth="280"
                    VerticalAlignment="Center"
                    Style="{StaticResource CompactSafetyTextStyle}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Name="RefreshButton"
                    Click="OnRefresh"
                    Content="{i18n:Loc Key='cinematics.refresh'}" />
                <ProgressRing
                    x:Name="BusyRing"
                    Width="18"
                    Height="18"
                    IsActive="False" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <ListView
                    x:Name="CinematicList"
                    Padding="8,4"
                    IsItemClickEnabled="False"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TagPath}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{Binding TransitionPath}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    MinWidth="88"
                                    VerticalAlignment="Center"
                                    Click="OnPlay"
                                    Content="{i18n:Loc Key='cinematics.play'}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Tag="{Binding}"
                                    ToolTipService.ToolTip="{Binding PlayScript}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="EmptyState"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="36"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE786;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="{i18n:Loc Key='cinematics.empty_title'}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{i18n:Loc Key='cinematics.empty_hint'}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar
            x:Name="StatusInfo"
            Grid.Row="2"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
