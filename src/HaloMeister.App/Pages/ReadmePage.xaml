                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="{i18n:Loc Key='readme.playfab_download_is_unavailable'}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:Loc Key='readme.select_authenticate_and_let_campaign_evol_141ed4'}" TextWrapping="Wrap" />
