<Page
    x:Class="HaloMeister.App.Pages.SpawnerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:Loc Key='spawner.spawner'}" />
                <TextBlock
                    Style="{StaticResource LivePageDescriptionStyle}"
                    Text="{i18n:Loc Key='spawner.browse_loaded_mission_objects_choose_a_va_4ab1aa'}"
                    />
            </StackPanel>
            <Button
                x:Name="ScanButton"
                Grid.Column="1"
                Click="OnScan"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="{i18n:Loc Key='spawner.scan_loaded_mission'}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="SpawnTypePicker"
                Header="{i18n:Loc Key='spawner.spawn_type'}"
                IsEnabled="False"
                SelectionChanged="OnSpawnTypeChanged">
                <ComboBoxItem Content="{i18n:Loc Key='spawner.characters'}" Tag="character" />
                <ComboBoxItem Content="{i18n:Loc Key='spawner.johnson_spartan_ai'}" Tag="armor" />
                <ComboBoxItem Content="{i18n:Loc Key='spawner.vehicles'}" Tag="vehicle" />
            </ComboBox>
            <ComboBox
                x:Name="CategoryPicker"
                Grid.Column="1"
                DisplayMemberPath="Label"
                Header="{i18n:Loc Key='spawner.category'}"
                IsEnabled="False"
                SelectionChanged="OnCategoryChanged" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="2"
                Header="{i18n:Loc Key='spawner.search'}"
                IsEnabled="False"
                PlaceholderText="{i18n:Loc Key='spawner.search_names_categories_variants_or_tag_paths'}"
                TextChanged="OnSearchChanged" />
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="2"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="360" />
                <ColumnDefinition Width="7*" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,14,16,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="CatalogTitle"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{i18n:Loc Key='spawner.characters'}" />
                            <TextBlock
                                x:Name="CatalogSubtitle"
                                FontSize="12"
                                Opacity="0.66"
                                Text="{i18n:Loc Key='spawner.scan_the_loaded_mission_to_populate_the_catalog'}" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Padding="9,4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="12"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="CountText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="0" />
                        </Border>
                    </Grid>

                    <ListView
                        x:Name="SpawnList"
                        Grid.Row="1"
                        IsItemClickEnabled="True"
                        ItemClick="OnSpawnItemClicked"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="Margin" Value="8,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="40"
                                        Height="40"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <FontIcon
                                            FontSize="18"
                                            Glyph="&#xE7FC;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                FontSize="12"
                                                Opacity="0.76"
                                                Text="{Binding Category}" />
                                            <TextBlock
                                                FontSize="12"
                                                Opacity="0.45"
                                                Text="•" />
                                            <TextBlock
                                                FontSize="12"
                                                Opacity="0.66"
                                                Text="{Binding VariantSummary}" />
                                        </StackPanel>
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Opacity="0.50"
                                            Text="{Binding TagPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="EmptyCatalogText"
                        Grid.Row="1"
                        Margin="24"
                        HorizontalAlignment="Center"
                        Opacity="0.62"
                        Text="{i18n:Loc Key='spawner.no_matching_objects'}"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="16,8,16,14"
                        FontSize="11"
                        Opacity="0.55"
                        Text="{i18n:Loc Key='spawner.duplicate_tag_rows_are_collapsed_variants_0c4f50'}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <StackPanel
                        x:Name="EmptySelectionPanel"
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <FontIcon
                            FontSize="42"
                            Glyph="&#xE7FC;"
                            Opacity="0.45" />
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Text="{i18n:Loc Key='spawner.choose_something_to_spawn'}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.62"
                            Text="{i18n:Loc Key='spawner.select_an_item_from_the_catalog_to_inspec_8654cb'}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="SelectionPanel"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock
                                        x:Name="SelectedNameText"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="SelectedCategoryText"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        x:Name="SelectedTagText"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Opacity="0.60"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Border
                                    x:Name="ArmorPreviewBorder"
                                    Grid.Column="1"
                                    Width="150"
                                    Height="110"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="7"
                                    Visibility="Collapsed">
                                    <Image
                                        x:Name="ArmorPreview"
                                        Stretch="UniformToFill" />
                                </Border>
                            </Grid>

                            <Border
                                x:Name="VariantPanel"
                                Padding="14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="7">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{i18n:Loc Key='spawner.variant'}" />
                                    <ComboBox
                                        x:Name="VariantPicker"
                                        DisplayMemberPath="Name"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="OnVariantChanged" />
                                    <TextBlock
                                        x:Name="VariantDetailText"
                                        FontSize="12"
                                        Opacity="0.65" />
                                </StackPanel>
                            </Border>

                            <TextBlock
                                x:Name="BridgeStatusText"
                                FontSize="12"
                                Opacity="0.68"
                                Text="{i18n:Loc Key='spawner.connect_to_inspect_bridge_status'}"
                                TextWrapping="Wrap" />

                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Severity="Warning"
                                Title="{i18n:Loc Key='spawner.experimental_native_action'}"
                                Message="{i18n:Loc Key='spawner.spawning_can_destabilize_the_current_offl_e42706'}" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    x:Name="SpawnButton"
                                    Click="OnSpawn"
                                    IsEnabled="False"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <SymbolIcon Symbol="Add" />
                                        <TextBlock Text="{i18n:Loc Key='spawner.spawn_ahead_of_player'}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="SpawnTeamButton"
                                    Click="OnSpawnTeam"
                                    IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <SymbolIcon Symbol="People" />
                                        <TextBlock Text="{i18n:Loc Key='spawner.spawn_team_5_ai'}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="SpawnArmorAiButton"
                                    Click="OnSpawnArmorAi"
                                    IsEnabled="False"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <SymbolIcon Symbol="People" />
                                        <TextBlock Text="{i18n:Loc Key='spawner.spawn_with_johnson_ai'}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border
                                Padding="14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="7">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{i18n:Loc Key='spawner.mixed_ai_team'}" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.65"
                                            Text="{i18n:Loc Key='spawner.add_character_ai_or_spartan_armor_driven_26480f'}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            x:Name="TeamQuantityBox"
                                            Header="{i18n:Loc Key='spawner.quantity'}"
                                            LargeChange="5"
                                            Maximum="50"
                                            Minimum="1"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="1" />
                                        <Button
                                            x:Name="AddToTeamButton"
                                            Grid.Column="1"
                                            Click="OnAddToTeam"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <SymbolIcon Symbol="Add" />
                                                <TextBlock Text="{i18n:Loc Key='spawner.add_selection_to_team'}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                        <CheckBox
                                            x:Name="FriendlyCompanionBox"
                                            Content="{i18n:Loc Key='spawner.friendly_companion_follow_player'}" />
                                        <CheckBox
                                            x:Name="RandomizeVariantsBox"
                                            Content="{i18n:Loc Key='spawner.randomize_variants'}" />
                                        <CheckBox
                                            x:Name="RandomizeWeaponsBox"
                                            Content="{i18n:Loc Key='spawner.randomize_authored_weapons'}" />
                                    </StackPanel>
                                    <ListView
                                        x:Name="TeamCompositionList"
                                        MaxHeight="190"
                                        SelectionChanged="OnTeamCompositionSelectionChanged"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{Binding DisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Opacity="0.62"
                                                            Text="{Binding Detail}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding QuantityLabel}"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock
                                        x:Name="EmptyTeamText"
                                        FontSize="12"
                                        Opacity="0.58"
                                        Text="{i18n:Loc Key='spawner.no_team_members_queued'}"
                                        TextAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="SpawnCompositionButton"
                                            Click="OnSpawnComposition"
                                            IsEnabled="False"
                                            Style="{StaticResource AccentButtonStyle}">
                                            <TextBlock Text="{i18n:Loc Key='spawner.spawn_mixed_team'}" />
                                        </Button>
                                        <Button
                                            x:Name="RemoveTeamItemButton"
                                            Click="OnRemoveTeamItem"
                                            IsEnabled="False">
                                            <TextBlock Text="{i18n:Loc Key='spawner.remove_selected'}" />
                                        </Button>
                                        <Button
                                            x:Name="ClearTeamButton"
                                            Click="OnClearTeam"
                                            IsEnabled="False">
                                            <TextBlock Text="{i18n:Loc Key='spawner.clear'}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
