<Page
    x:Class="HaloMeister.App.Pages.SpawnerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Width="52"
                Height="52"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="14"
                VerticalAlignment="Center">
                <FontIcon
                    FontSize="24"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Glyph="&#xE7FC;"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:Loc Key='spawner.spawner'}" />
                <TextBlock
                    Style="{StaticResource LivePageDescriptionStyle}"
                    Text="{i18n:Loc Key='spawner.browse_loaded_mission_objects_choose_a_va_4ab1aa'}"
                    />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="ScanButton"
                    Click="OnScan"
                    IsEnabled="False"
                    MinHeight="38"
                Padding="18,6"
                CornerRadius="8"
                Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="{i18n:Loc Key='spawner.scan_loaded_mission'}" />
                    </StackPanel>
                </Button>
                <ProgressRing
                    x:Name="BusyRing"
                    Width="22"
                    Height="22"
                    IsActive="False" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="16,12,16,14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="SpawnTypePicker"
                    HorizontalAlignment="Stretch"
                    Header="{i18n:Loc Key='spawner.spawn_type'}"
                    IsEnabled="False"
                    SelectionChanged="OnSpawnTypeChanged">
                    <ComboBoxItem Content="{i18n:Loc Key='spawner.characters'}" Tag="character" />
                    <ComboBoxItem Content="{i18n:Loc Key='spawner.johnson_spartan_ai'}" Tag="armor" />
                    <ComboBoxItem Content="{i18n:Loc Key='spawner.vehicles'}" Tag="vehicle" />
                </ComboBox>
                <ComboBox
                    x:Name="CategoryPicker"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Label"
                    Header="{i18n:Loc Key='spawner.category'}"
                    IsEnabled="False"
                    SelectionChanged="OnCategoryChanged" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="2"
                    Header="{i18n:Loc Key='spawner.search'}"
                    IsEnabled="False"
                    PlaceholderText="{i18n:Loc Key='spawner.search_names_categories_variants_or_tag_paths'}"
                    TextChanged="OnSearchChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="360" />
                <ColumnDefinition Width="7*" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                        Padding="18,16,18,12"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="CatalogTitle"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{i18n:Loc Key='spawner.characters'}" />
                            <TextBlock
                                x:Name="CatalogSubtitle"
                                FontSize="12"
                                Opacity="0.66"
                                Text="{i18n:Loc Key='spawner.scan_the_loaded_mission_to_populate_the_catalog'}" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Padding="10,3"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="12"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="CountText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="0" />
                        </Border>
                    </Grid>

                    <ListView
                        x:Name="SpawnList"
                        Grid.Row="1"
                        IsItemClickEnabled="True"
                        ItemClick="OnSpawnItemClicked"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,9" />
                                <Setter Property="Margin" Value="10,2" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Header>
                            <Border Height="6" />
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="44"
                                        Height="44"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <FontIcon
                                            FontSize="19"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE7FC;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding SecondaryName}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding SecondaryNameVisibility}" />
                                        </Grid>
                                        <StackPanel
                                            Margin="0,2,0,1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Border
                                                Padding="7,1,7,2"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{Binding Category}" />
                                            </Border>
                                            <TextBlock
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding VariantSummary}" />
                                        </StackPanel>
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{Binding TagPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="EmptyCatalogText"
                        Grid.Row="1"
                        Margin="24"
                        HorizontalAlignment="Center"
                        Opacity="0.62"
                        Text="{i18n:Loc Key='spawner.no_matching_objects'}"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />

                    <Border
                        Grid.Row="2"
                        Padding="18,10,18,12"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{i18n:Loc Key='spawner.duplicate_tag_rows_are_collapsed_variants_0c4f50'}"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <StackPanel
                        x:Name="EmptySelectionPanel"
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        VerticalAlignment="Center">
                        <Border
                            Width="84"
                            Height="84"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="42">
                            <FontIcon
                                FontSize="38"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE7FC;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.85" />
                        </Border>
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Text="{i18n:Loc Key='spawner.choose_something_to_spawn'}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.62"
                            Text="{i18n:Loc Key='spawner.select_an_item_from_the_catalog_to_inspec_8654cb'}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="SelectionPanel"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel Spacing="18">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        x:Name="SelectedNameText"
                                        FontSize="26"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <Border
                                        Padding="10,2,10,3"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <TextBlock
                                            x:Name="SelectedCategoryText"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <Border
                                        Padding="10,6"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <TextBlock
                                            x:Name="SelectedTagText"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            IsTextSelectionEnabled="True"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                                <Border
                                    x:Name="ArmorPreviewBorder"
                                    Grid.Column="1"
                                    Width="180"
                                    Height="132"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                    <Image
                                        x:Name="ArmorPreview"
                                        Stretch="UniformToFill" />
                                </Border>
                            </Grid>

                            <Border
                                x:Name="VariantPanel"
                                Padding="16"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE790;"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{i18n:Loc Key='spawner.variant'}" />
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="VariantPicker"
                                        DisplayMemberPath="Name"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="OnVariantChanged" />
                                    <TextBlock
                                        x:Name="VariantDetailText"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE946;"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="BridgeStatusText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{i18n:Loc Key='spawner.connect_to_inspect_bridge_status'}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Severity="Warning"
                                Title="{i18n:Loc Key='spawner.experimental_native_action'}"
                                Message="{i18n:Loc Key='spawner.spawning_can_destabilize_the_current_offl_e42706'}" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    x:Name="SpawnButton"
                                    AllowFocusWhenDisabled="True"
                                    Click="OnSpawn"
                                    IsEnabled="False"
                                    MinHeight="40"
                                    Padding="22,8"
                                    CornerRadius="8"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Add" />
                                        <TextBlock Text="{i18n:Loc Key='spawner.spawn_ahead_of_player'}" />
                                    </StackPanel>
                                </Button>
                                <!-- Temporarily hidden: spawn team (5 AI)
                                <Button
                                    x:Name="SpawnTeamButton"
                                    AllowFocusWhenDisabled="True"
                                    Click="OnSpawnTeam"
                                    IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <SymbolIcon Symbol="People" />
                                        <TextBlock Text="{i18n:Loc Key='spawner.spawn_team_5_ai'}" />
                                    </StackPanel>
                                </Button>
                                -->
                                <Button
                                    x:Name="SpawnArmorAiButton"
                                    AllowFocusWhenDisabled="True"
                                    Click="OnSpawnArmorAi"
                                    IsEnabled="False"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <SymbolIcon Symbol="People" />
                                        <TextBlock Text="{i18n:Loc Key='spawner.spawn_with_johnson_ai'}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Temporarily hidden: mixed AI team builder
                            <Border
                                Padding="14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="7">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{i18n:Loc Key='spawner.mixed_ai_team'}" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.65"
                                            Text="{i18n:Loc Key='spawner.add_character_ai_or_spartan_armor_driven_26480f'}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            x:Name="TeamQuantityBox"
                                            Header="{i18n:Loc Key='spawner.quantity'}"
                                            LargeChange="5"
                                            Maximum="50"
                                            Minimum="1"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="1" />
                                        <Button
                                            x:Name="AddToTeamButton"
                                            Grid.Column="1"
                                            AllowFocusWhenDisabled="True"
                                            Click="OnAddToTeam"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <SymbolIcon Symbol="Add" />
                                                <TextBlock Text="{i18n:Loc Key='spawner.add_selection_to_team'}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ListView
                                        x:Name="TeamCompositionList"
                                        MaxHeight="260"
                                        SelectionChanged="OnTeamCompositionSelectionChanged"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="10" Padding="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{Binding DisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Opacity="0.62"
                                                            Text="{Binding Detail}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Margin="0,0,8,0"
                                                        Text="{Binding QuantityLabel}"
                                                        VerticalAlignment="Center" />
                                                    <StackPanel
                                                        Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="10"
                                                        VerticalAlignment="Center">
                                                        <ComboBox
                                                            MinWidth="148"
                                                            DisplayMemberPath="Label"
                                                            ItemsSource="{Binding StanceChoices}"
                                                            SelectedItem="{Binding SelectedStance, Mode=TwoWay}" />
                                                        <CheckBox
                                                            Content="{Binding RandomizeVariantsLabel}"
                                                            IsChecked="{Binding RandomizeVariants, Mode=TwoWay}" />
                                                        <CheckBox
                                                            Content="{Binding RandomizeWeaponsLabel}"
                                                            IsChecked="{Binding RandomizeWeapons, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock
                                        x:Name="EmptyTeamText"
                                        FontSize="12"
                                        Opacity="0.58"
                                        Text="{i18n:Loc Key='spawner.no_team_members_queued'}"
                                        TextAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="SpawnCompositionButton"
                                            AllowFocusWhenDisabled="True"
                                            Click="OnSpawnComposition"
                                            IsEnabled="False"
                                            Style="{StaticResource AccentButtonStyle}">
                                            <TextBlock Text="{i18n:Loc Key='spawner.spawn_mixed_team'}" />
                                        </Button>
                                        <Button
                                            x:Name="RemoveTeamItemButton"
                                            AllowFocusWhenDisabled="True"
                                            Click="OnRemoveTeamItem"
                                            IsEnabled="False">
                                            <TextBlock Text="{i18n:Loc Key='spawner.remove_selected'}" />
                                        </Button>
                                        <Button
                                            x:Name="ClearTeamButton"
                                            AllowFocusWhenDisabled="True"
                                            Click="OnClearTeam"
                                            IsEnabled="False">
                                            <TextBlock Text="{i18n:Loc Key='spawner.clear'}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
