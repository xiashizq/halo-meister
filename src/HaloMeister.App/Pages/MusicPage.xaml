<Page
    x:Class="HaloMeister.App.Pages.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="12,4,12,0"
            Background="{ThemeResource LayerFillColorAltBrush}">
            <NavigationView
                x:Name="SectionNav"
                AlwaysShowHeader="False"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                PaneDisplayMode="Top"
                SelectionChanged="OnSectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        x:Name="MusicTab"
                        Content="{i18n:Loc Key='music.tab'}"
                        Icon="Audio"
                        IsSelected="True"
                        Tag="music" />
                    <NavigationViewItem
                        x:Name="DialogueTab"
                        Content="{i18n:Loc Key='dialogue.tab'}"
                        Icon="Message"
                        Tag="dialogue" />
                    <NavigationViewItem
                        x:Name="VehicleTab"
                        Content="{i18n:Loc Key='vehicle.tab'}"
                        Tag="vehicle">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE804;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="WeaponTab"
                        Content="{i18n:Loc Key='weapon.tab'}"
                        Tag="weapon">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE7FC;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="CharacterTab"
                        Content="{i18n:Loc Key='character.tab'}"
                        Tag="character">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE77B;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="DialogTab"
                        Content="{i18n:Loc Key='dialog.tab'}"
                        Tag="dialog">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8BD;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="SandboxTab"
                        Content="{i18n:Loc Key='sandbox.tab'}"
                        Tag="sandbox">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE7C8;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="DeviceTab"
                        Content="{i18n:Loc Key='device.tab'}"
                        Tag="device">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="LevelsTab"
                        Content="{i18n:Loc Key='levels.tab'}"
                        Tag="levels">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE81E;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="MaterialsTab"
                        Content="{i18n:Loc Key='materials.tab'}"
                        Tag="materials">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE2B1;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="UiTab"
                        Content="{i18n:Loc Key='ui.tab'}"
                        Tag="ui">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE771;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="VisualFxTab"
                        Content="{i18n:Loc Key='visual_fx.tab'}"
                        Tag="visual_fx">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE734;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
            </NavigationView>
        </Border>

        <Grid
            Grid.Row="1"
            Padding="24,12,24,24"
            VerticalAlignment="Stretch"
            RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="RefreshButton"
                                Click="OnRefresh"
                                Content="{i18n:Loc Key='music.refresh'}" />
                            <ProgressRing
                                x:Name="BusyRing"
                                Width="18"
                                Height="18"
                                IsActive="False"
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="ExportTrackButton"
                                Click="OnExportTrack"
                                Content="{i18n:Loc Key='music.export_track'}" />
                        </StackPanel>
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            PlaceholderText="{i18n:Loc Key='music.search'}"
                            TextChanged="OnSearchChanged" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Name="CategoryCaption"
                                    Margin="12,10,12,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{i18n:Loc Key='music.categories'}" />
                                <ListView
                                    x:Name="CategoryList"
                                    Grid.Row="1"
                                    Padding="4"
                                    SelectionChanged="OnCategorySelected"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Padding="4,8"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{Binding Name}" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="16,10,16,4" Spacing="2">
                                    <TextBlock
                                        x:Name="VariantCaption"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{i18n:Loc Key='music.variants'}" />
                                    <TextBlock
                                        x:Name="CueText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{i18n:Loc Key='music.select_track'}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                <ListView
                                    x:Name="PermutationList"
                                    Padding="8,0,8,8"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding PathText}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{Binding PathVisibility}" />
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Location}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{Binding LocationVisibility}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    MinWidth="88"
                                                    VerticalAlignment="Center"
                                                    Click="OnPlay"
                                                    Content="{Binding PlayLabel}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Tag="{Binding}" />
                                                <Button
                                                    Grid.Column="2"
                                                    MinWidth="72"
                                                    VerticalAlignment="Center"
                                                    Click="OnExportOne"
                                                    Content="{i18n:Loc Key='music.export'}"
                                                    Tag="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel
                                    x:Name="EmptyState"
                                    Padding="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="32"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE8D6;" />
                                    <TextBlock
                                        x:Name="EmptyTitle"
                                        HorizontalAlignment="Center"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        Text="{i18n:Loc Key='music.empty_title'}"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        x:Name="EmptyHint"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{i18n:Loc Key='music.empty_hint'}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Padding="16,10"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        x:Name="NowPlayingTitle"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="NowPlayingDetail"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    x:Name="LanguageHost"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                    <FontIcon
                                        FontSize="14"
                                        Glyph="&#xE774;"
                                        VerticalAlignment="Center" />
                                    <ComboBox
                                        x:Name="LanguageBox"
                                        MinWidth="168"
                                        VerticalAlignment="Center"
                                        SelectionChanged="OnLanguageChanged" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                                    <Button
                                        x:Name="VolumeButton"
                                        Padding="8,6"
                                        VerticalAlignment="Center"
                                        Click="OnVolumeMute"
                                        ToolTipService.ToolTip="{i18n:Loc Key='music.mute'}">
                                        <FontIcon
                                            x:Name="VolumeIcon"
                                            FontSize="16"
                                            Glyph="&#xE767;" />
                                    </Button>
                                    <Slider
                                        x:Name="VolumeSlider"
                                        Width="112"
                                        MinWidth="112"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="100"
                                        ToolTipService.ToolTip="{i18n:Loc Key='music.volume'}"
                                        ValueChanged="OnVolumeChanged" />
                                </StackPanel>
                                <Button
                                    x:Name="TransportButton"
                                    Grid.Column="3"
                                    MinWidth="88"
                                    VerticalAlignment="Center"
                                    Click="OnTransport"
                                    IsEnabled="False" />
                            </Grid>
                            <Grid
                                x:Name="WaveformHost"
                                Grid.Row="1"
                                Height="88"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                PointerPressed="OnWaveformPressed"
                                PointerMoved="OnWaveformMoved"
                                PointerReleased="OnWaveformReleased"
                                PointerCaptureLost="OnWaveformReleased">
                                <Canvas
                                    x:Name="WaveformCanvas"
                                    Margin="0,0,0,18"
                                    SizeChanged="OnWaveformSized" />
                                <Rectangle
                                    x:Name="WavePlayhead"
                                    Width="2"
                                    Margin="0,0,0,18"
                                    HorizontalAlignment="Left"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="WavePlayheadShift" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <TextBlock
                                    x:Name="ElapsedText"
                                    Margin="8,0,0,2"
                                    VerticalAlignment="Bottom"
                                    FontSize="12"
                                    IsHitTestVisible="False"
                                    Text="0:00" />
                                <TextBlock
                                    x:Name="DurationText"
                                    Margin="0,0,8,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    FontSize="12"
                                    IsHitTestVisible="False"
                                    Text="0:00" />
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
        <Border
            x:Name="ToastHost"
            Grid.RowSpan="2"
            Margin="0,0,24,24"
            Padding="14,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            MaxWidth="420"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ToastText"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</Page>
