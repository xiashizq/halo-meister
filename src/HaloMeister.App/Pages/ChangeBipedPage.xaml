<Page
    x:Class="HaloMeister.App.Pages.ChangeBipedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            MaxWidth="1180"
            Padding="24"
            HorizontalAlignment="Stretch"
            Spacing="18">

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="{i18n:Loc Key='change_biped.change_character'}" />
                    <TextBlock
                        Style="{StaticResource LivePageDescriptionStyle}"
                        Text="{i18n:Loc Key='change_biped.switch_to_a_loaded_character_ai_bipeds_ma_7f6d33'}" />
                </StackPanel>
                <Button
                    x:Name="ConnectScanButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="OnConnectAndScan"
                    Content="{i18n:Loc Key='change_biped.scan_mission'}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{i18n:Loc Key='change_biped.this_tool_does_not_work_yet_and_is_disabl_86a291'}"
                Severity="Warning"
                Title="{i18n:Loc Key='change_biped.not_working_yet'}" />

            <Border
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            x:Name="GameStateDot"
                            Width="9"
                            Height="9"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{i18n:Loc Key='change_biped.game'}" />
                            <TextBlock x:Name="GameStateText" Text="{i18n:Loc Key='change_biped.disconnected'}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Ellipse
                            x:Name="BridgeStateDot"
                            Width="9"
                            Height="9"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{i18n:Loc Key='change_biped.switch_bridge'}" />
                            <TextBlock x:Name="BridgeStateText" Text="{i18n:Loc Key='change_biped.not_ready'}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Ellipse
                            x:Name="ScanStateDot"
                            Width="9"
                            Height="9"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{i18n:Loc Key='change_biped.mission_tags'}" />
                            <TextBlock x:Name="ScanStateText" Text="{i18n:Loc Key='change_biped.not_scanned'}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            x:Name="RefreshButton"
                            Click="OnRefresh"
                            Content="{i18n:Loc Key='change_biped.refresh'}"
                            IsEnabled="False" />
                        <ProgressRing
                            x:Name="BusyRing"
                            Width="22"
                            Height="22"
                            IsActive="False" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Padding="16,14,16,10" Spacing="8">
                            <Grid>
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{i18n:Loc Key='change_biped.mission_characters'}" />
                                <TextBlock
                                    x:Name="CountText"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <TextBox
                                x:Name="SearchBox"
                                IsEnabled="False"
                                PlaceholderText="{i18n:Loc Key='change_biped.search_name_species_or_tag_path'}"
                                TextChanged="OnSearchChanged" />
                        </StackPanel>

                        <ListView
                            x:Name="BipedList"
                            Grid.Row="1"
                            Height="540"
                            IsItemClickEnabled="False"
                            SelectionChanged="OnBipedSelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="6,5"
                                        ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                MaxWidth="285"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding TagPath}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="1"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="10">
                                            <TextBlock
                                                FontSize="11"
                                                Text="{Binding Category}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="14">
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    x:Name="SelectedNameText"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="{i18n:Loc Key='change_biped.select_a_character'}" />
                                <TextBlock
                                    x:Name="SelectedCategoryText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="SelectedPathText"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Rectangle
                                Height="1"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="5">
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{i18n:Loc Key='change_biped.switch_now'}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{i18n:Loc Key='change_biped.spawns_the_selected_biped_close_to_the_pl_82cc5c'}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                x:Name="SwitchNowButton"
                                HorizontalAlignment="Stretch"
                                Click="OnSwitchNow"
                                Content="{i18n:Loc Key='change_biped.switch_to_selected_character'}"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />

                            <TextBlock
                                x:Name="SwitchAvailabilityText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

                            <Button
                                x:Name="DisableSwitchButton"
                                HorizontalAlignment="Left"
                                Click="OnDisableSwitch"
                                Content="{i18n:Loc Key='change_biped.turn_off_collision_switching'}"
                                IsEnabled="False" />
                        </StackPanel>
                    </Border>

                    <Expander Header="{i18n:Loc Key='change_biped.advanced_change_the_next_checkpoint_spawn_8ee8f6'}">
                        <Border
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="0,0,8,8">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{i18n:Loc Key='change_biped.patches_the_loaded_globals_scenario_playe_93bac5'}"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="ApplyOverrideButton"
                                        Click="OnApplyOverride"
                                        Content="{i18n:Loc Key='change_biped.use_on_checkpoint_reload'}"
                                        IsEnabled="False" />
                                    <Button
                                        x:Name="RestoreOverrideButton"
                                        Click="OnRestoreOverride"
                                        Content="{i18n:Loc Key='change_biped.restore_original_biped'}"
                                        IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <InfoBar
                        x:Name="StatusBar"
                        IsClosable="True"
                        IsOpen="False" />

                    <TextBlock
                        x:Name="DiagnosticText"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
