<Page
    x:Class="HaloMeister.App.Pages.BuiltinModPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{i18n:Loc Key='builtin_mod.title'}" />
                <TextBlock
                    Style="{StaticResource LivePageDescriptionStyle}"
                    Text="{i18n:Loc Key='builtin_mod.description'}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    x:Name="BusyRing"
                    Width="22"
                    Height="22"
                    VerticalAlignment="Center"
                    IsActive="False" />
                <Button
                    x:Name="RefreshButton"
                    VerticalAlignment="Center"
                    Click="OnRefresh"
                    Content="{i18n:Loc Key='builtin_mod.refresh'}" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="RestartBanner"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Severity="Warning"
            Title="{i18n:Loc Key='builtin_mod.restart_title'}"
            Message="{i18n:Loc Key='builtin_mod.restart_message'}" />

        <ScrollViewer
            x:Name="ModListHost"
            Grid.Row="2"
            Opacity="0"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ModList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0" Style="{StaticResource LiveToolCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="148" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{Binding Definition.PosterUri, Converter={StaticResource BuiltinModPosterConverter}}"
                                    CornerRadius="9,0,0,9" />
                                <StackPanel Grid.Column="1" Margin="16,14,16,14" Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Stem}" />
                                    </StackPanel>
                                    <TextBlock
                                        Style="{StaticResource LivePageDescriptionStyle}"
                                        Text="{Binding Description}" />
                                    <TextBlock
                                        Style="{StaticResource CompactSafetyTextStyle}"
                                        Text="{Binding Notes}"
                                        Visibility="{Binding NotesVisibility}" />
                                    <TextBlock
                                        Style="{StaticResource LivePageDescriptionStyle}"
                                        Text="{Binding Status}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Click="OnInstall"
                                            Content="{Binding InstallLabel}"
                                            IsEnabled="{Binding CanInstall, FallbackValue=False, TargetNullValue=False}"
                                            Loaded="OnInstallButtonLoaded"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Tag="{Binding}" />
                                        <Button
                                            Click="OnRemove"
                                            Content="{i18n:Loc Key='builtin_mod.remove'}"
                                            IsEnabled="{Binding CanRemove}"
                                            Tag="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="3"
            IsOpen="False"
            IsClosable="True" />

        <Grid
            x:Name="LoadingOverlay"
            Grid.RowSpan="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="40"
                    Height="40"
                    IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{i18n:Loc Key='common.loading'}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
