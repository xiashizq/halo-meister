<Page
    x:Class="HaloMeister.App.Pages.BuiltinModPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HaloMeister.App.Controls"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Page.Resources>
        <ItemsPanelTemplate x:Key="ModGridPanel">
            <controls:TwoColumnPanel ColumnSpacing="16" RowSpacing="16" />
        </ItemsPanelTemplate>

        <Style x:Key="ModChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <DataTemplate x:Key="ModCardTemplate">
            <Border
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Style="{StaticResource LiveToolCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="172" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Poster: Image control (bindings work here); corners are clipped in code -->
                    <Grid MinHeight="230">
                        <Image
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            SizeChanged="OnPosterSizeChanged"
                            Source="{Binding Poster}"
                            Stretch="UniformToFill" />
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0.6" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#33000000" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" Margin="18,16,18,16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Title + chips -->
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{Binding Title}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Style="{StaticResource ModChipStyle}">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Stem}" />
                                </Border>
                                <Border Style="{StaticResource ModChipStyle}" Visibility="{Binding VersionVisibility}">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Version}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Description -->
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource LivePageDescriptionStyle}"
                            Text="{Binding Description}" />

                        <!-- Notes -->
                        <Border
                            Grid.Row="2"
                            VerticalAlignment="Top"
                            Style="{StaticResource LiveToolInsetStyle}"
                            Visibility="{Binding NotesVisibility}">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Margin="0,2,0,0"
                                    VerticalAlignment="Top"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE946;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource CompactSafetyTextStyle}"
                                    Text="{Binding Notes}" />
                            </Grid>
                        </Border>

                        <!-- Status -->
                        <Grid Grid.Row="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Margin="0,2,0,0"
                                VerticalAlignment="Top"
                                FontSize="14"
                                Foreground="{Binding StatusBrush}"
                                Glyph="{Binding StatusGlyph}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="13"
                                Text="{Binding Status}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <!-- Actions -->
                        <StackPanel
                            Grid.Row="4"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                MinWidth="116"
                                Click="OnInstall"
                                IsEnabled="{Binding CanInstall, FallbackValue=False, TargetNullValue=False}"
                                Loaded="OnInstallButtonLoaded"
                                Style="{StaticResource AccentButtonStyle}"
                                Tag="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                                    <TextBlock Text="{Binding InstallLabel}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Click="OnRemove"
                                IsEnabled="{Binding CanRemove}"
                                Tag="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    <TextBlock Text="{i18n:Loc Key='builtin_mod.remove'}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{i18n:Loc Key='builtin_mod.title'}" />
                <TextBlock
                    Style="{StaticResource LivePageDescriptionStyle}"
                    Text="{i18n:Loc Key='builtin_mod.description'}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="10">
                <ProgressRing
                    x:Name="BusyRing"
                    Width="22"
                    Height="22"
                    VerticalAlignment="Center"
                    IsActive="False" />
                <Button
                    x:Name="RefreshButton"
                    VerticalAlignment="Center"
                    Click="OnRefresh">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="{i18n:Loc Key='builtin_mod.refresh'}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="RestartBanner"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="True"
            Severity="Warning"
            Title="{i18n:Loc Key='builtin_mod.restart_title'}"
            Message="{i18n:Loc Key='builtin_mod.restart_message'}" />

        <Pivot
            x:Name="ModListHost"
            Grid.Row="2"
            Opacity="0">
            <PivotItem
                Header="{i18n:Loc Key='builtin_mod.tab_core'}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <Grid x:Name="CoreHost" Padding="0,8,0,0" SizeChanged="OnModHostSizeChanged">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            x:Name="CoreModList"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Top"
                            ItemTemplate="{StaticResource ModCardTemplate}"
                            ItemsPanel="{StaticResource ModGridPanel}" />
                    </ScrollViewer>
                </Grid>
            </PivotItem>
            <PivotItem
                Header="{i18n:Loc Key='builtin_mod.tab_enhance'}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <Grid x:Name="EnhanceHost" Padding="0,8,0,0" SizeChanged="OnModHostSizeChanged">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            x:Name="EnhanceModList"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Top"
                            ItemTemplate="{StaticResource ModCardTemplate}"
                            ItemsPanel="{StaticResource ModGridPanel}" />
                    </ScrollViewer>
                </Grid>
            </PivotItem>
        </Pivot>

        <Grid
            x:Name="LoadingOverlay"
            Grid.RowSpan="3"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="40"
                    Height="40"
                    IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{i18n:Loc Key='common.loading'}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
