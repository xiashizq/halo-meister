<Page
    x:Class="HaloMeister.App.Pages.AdvancedMachinimaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization"
    Loaded="OnLoaded">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{i18n:Loc Key='advanced_machinima.machinima'}" />
                <TextBlock
                    Style="{StaticResource LivePageDescriptionStyle}"
                    Text="{i18n:Loc Key='advanced_machinima.use_halo_s_native_machinima_camera_reuse_dfcf25'}"
                    />
            </StackPanel>

            <Border
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{i18n:Loc Key='advanced_machinima.machinima_mode'}" />
                            <TextBlock
                                x:Name="ModeStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{i18n:Loc Key='advanced_machinima.bridge_status_not_checked'}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Button
                                x:Name="EnterButton"
                                Click="OnEnter"
                                Content="{i18n:Loc Key='advanced_machinima.enter_machinima_mode'}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="ExitButton"
                                Click="OnExit"
                                Content="{i18n:Loc Key='advanced_machinima.leave_and_restore'}"
                                IsEnabled="False" />
                            <Button
                                x:Name="RefreshButton"
                                Click="OnRefresh"
                                Content="{i18n:Loc Key='advanced_machinima.refresh'}" />
                            <ProgressRing
                                x:Name="BusyRing"
                                Width="22"
                                Height="22"
                                IsActive="False" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{i18n:Loc Key='advanced_machinima.fly_with_halo_s_native_machinima_controls_7a9923'}"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="{i18n:Loc Key='advanced_machinima.camera_position'}" />
                            <TextBlock
                                x:Name="PositionText"
                                FontFamily="Consolas"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="{i18n:Loc Key='advanced_machinima.camera_rotation'}" />
                            <TextBlock
                                x:Name="RotationText"
                                FontFamily="Consolas"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="{i18n:Loc Key='advanced_machinima.loaded_world'}" />
                            <TextBlock
                                x:Name="WorldText"
                                Text="—"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="14">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{i18n:Loc Key='advanced_machinima.authored_camera_nodes'}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='advanced_machinima.the_static_and_cinematic_cameras_previous_566353'}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="LiveNodeBox"
                            DisplayMemberPath="Name"
                            Header="{i18n:Loc Key='advanced_machinima.live_camera_location'}"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="{i18n:Loc Key='advanced_machinima.enter_mode_to_scan_camera_actors'}"
                            SelectionChanged="OnLiveNodeSelectionChanged" />
                        <TextBlock
                            x:Name="LiveNodeDetailText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='advanced_machinima.no_authored_camera_node_selected'}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='advanced_machinima.camera_move_not_ready_hint'}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="MoveCameraToLiveButton"
                                Click="OnMoveCameraToLive"
                                Content="{i18n:Loc Key='advanced_machinima.move_camera_here'}"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{i18n:Loc Key='advanced_machinima.camera_move_not_ready'}" />
                            <Button
                                x:Name="MoveSpartanToLiveButton"
                                Click="OnMoveSpartanToLive"
                                Content="{i18n:Loc Key='advanced_machinima.teleport_spartan_here'}"
                                IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="14">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{i18n:Loc Key='advanced_machinima.saved_locations'}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='advanced_machinima.save_as_many_camera_transforms_as_you_nee_e41559'}"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="LocationNameBox"
                                Header="{i18n:Loc Key='advanced_machinima.new_location_name'}"
                                PlaceholderText="{i18n:Loc Key='advanced_machinima.opening_shot'}" />
                            <Button
                                x:Name="SaveLocationButton"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="OnSaveLocation"
                                Content="{i18n:Loc Key='advanced_machinima.save_camera'}"
                                IsEnabled="False" />
                        </Grid>
                        <ComboBox
                            x:Name="SavedLocationBox"
                            DisplayMemberPath="Name"
                            Header="{i18n:Loc Key='advanced_machinima.saved_location'}"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="{i18n:Loc Key='advanced_machinima.no_saved_locations'}"
                            SelectionChanged="OnSavedLocationSelectionChanged" />
                        <TextBlock
                            x:Name="SavedLocationDetailText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='advanced_machinima.no_saved_location_selected'}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='advanced_machinima.camera_move_not_ready_hint'}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="MoveCameraToSavedButton"
                                Click="OnMoveCameraToSaved"
                                Content="{i18n:Loc Key='advanced_machinima.move_camera_here'}"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{i18n:Loc Key='advanced_machinima.camera_move_not_ready'}" />
                            <Button
                                x:Name="MoveSpartanToSavedButton"
                                Click="OnMoveSpartanToSaved"
                                Content="{i18n:Loc Key='advanced_machinima.teleport_spartan_here'}"
                                IsEnabled="False" />
                            <Button
                                x:Name="DeleteSavedButton"
                                Click="OnDeleteSaved"
                                Content="{i18n:Loc Key='advanced_machinima.delete'}"
                                IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar
                x:Name="StatusBar"
                IsClosable="True"
                IsOpen="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
