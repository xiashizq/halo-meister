<Page
    x:Class="HaloMeister.App.Pages.CollectiblesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Page.Resources>
        <DataTemplate x:Key="ProgressTagTemplate">
            <Border
                Margin="0,0,8,8"
                Padding="12,9"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Display}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontFamily="Consolas"
                            FontSize="10"
                            Text="{Binding Detail}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <CheckBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsSet, Mode=TwoWay}"
                        IsEnabled="{Binding IsEditable}" />
                </Grid>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ProgressWrapPanel">
            <ItemsWrapGrid
                ItemWidth="420"
                ItemHeight="64"
                Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Page.Resources>

    <Grid Padding="16,12,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:Loc Key='collectibles.terminals_checkpoints'}" />
                    <Border
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <TextBlock x:Name="ItemCountText" FontSize="11" />
                    </Border>
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{i18n:Loc Key='collectibles.manage_discovered_terminals_available_mis_7a2639'}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBox
                    x:Name="FilterBox"
                    Width="300"
                    PlaceholderText="{i18n:Loc Key='collectibles.search_terminals_and_checkpoints'}"
                    TextChanged="OnFilterChanged" />
                <Button Click="OnAll" Content="{i18n:Loc Key='collectibles.collect_all'}" />
                <Button Click="OnNone" Content="{i18n:Loc Key='collectibles.clear_all'}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">
                <Expander
                    x:Name="TerminalsExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{i18n:Loc Key='collectibles.terminals'}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="11"
                                Text="{i18n:Loc Key='collectibles.story_terminals_recorded_as_discovered'}" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl
                        x:Name="TerminalsList"
                        ItemTemplate="{StaticResource ProgressTagTemplate}"
                        ItemsPanel="{StaticResource ProgressWrapPanel}" />
                </Expander>

                <Expander
                    x:Name="InsertionExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{i18n:Loc Key='collectibles.mission_starting_points'}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="11"
                                Text="{i18n:Loc Key='collectibles.insertion_checkpoints_available_from_miss_71f813'}" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl
                        x:Name="InsertionList"
                        ItemTemplate="{StaticResource ProgressTagTemplate}"
                        ItemsPanel="{StaticResource ProgressWrapPanel}" />
                </Expander>

                <Expander
                    x:Name="GatesExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{i18n:Loc Key='collectibles.mission_access'}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="11"
                                Text="{i18n:Loc Key='collectibles.progress_gates_that_make_later_missions_s_ba0ff6'}" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl
                        x:Name="GatesList"
                        ItemTemplate="{StaticResource ProgressTagTemplate}"
                        ItemsPanel="{StaticResource ProgressWrapPanel}" />
                </Expander>

                <Expander
                    x:Name="ExtraExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Visibility="Collapsed">
                    <Expander.Header>
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{i18n:Loc Key='collectibles.unrecognized_progress_tags'}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="11"
                                Text="{i18n:Loc Key='collectibles.values_preserved_from_the_save_but_not_pr_1a7c60'}" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl
                        x:Name="ExtraList"
                        ItemTemplate="{StaticResource ProgressTagTemplate}"
                        ItemsPanel="{StaticResource ProgressWrapPanel}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
