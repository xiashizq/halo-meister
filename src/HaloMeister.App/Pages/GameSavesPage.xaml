<Page
    x:Class="HaloMeister.App.Pages.GameSavesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization">

    <Grid Padding="28,24,28,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="3">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:Loc Key='game_saves.game_saves'}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{i18n:Loc Key='game_saves.manage_live_checkpoints_and_recover_earli_52c3b2'}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="OnRefresh">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="{i18n:Loc Key='game_saves.refresh'}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="LaunchGameButton"
                    Click="OnLaunchGame"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock x:Name="LaunchGameButtonText" Text="{i18n:Loc Key='game_saves.launch_game'}" />
                    </StackPanel>
                </Button>
                <Button Content="{i18n:Loc Key='game_saves.more'}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                x:Name="OpenLiveFolderItem"
                                Click="OnOpenLiveFolder"
                                Text="{i18n:Loc Key='game_saves.open_live_save_folder'}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE838;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnOpenBackups" Text="{i18n:Loc Key='game_saves.open_backup_library'}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <SelectorBar
            x:Name="PlatformBar"
            Grid.Row="1"
            SelectionChanged="OnPlatformChanged">
            <SelectorBarItem
                x:Name="SteamPlatformItem"
                IsSelected="True"
                Tag="steam"
                Text="{i18n:Loc Key='game_saves.platform_steam'}" />
            <SelectorBarItem
                x:Name="StorePlatformItem"
                Tag="store"
                Text="{i18n:Loc Key='game_saves.platform_microsoft_store'}" />
        </SelectorBar>

        <Border
            Grid.Row="2"
            MinHeight="500"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46*" MinWidth="430" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="54*" MinWidth="480" />
                </Grid.ColumnDefinitions>

                <Grid Padding="14,18,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="8,0,8,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{i18n:Loc Key='game_saves.live_save_slots'}" />
                            <TextBlock
                                x:Name="StorageSourceText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                Text="{i18n:Loc Key='game_saves.stored_by_steam_savegames'}" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Padding="9,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="12">
                            <TextBlock
                                x:Name="SlotCountText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{i18n:Loc Key='game_saves.0_slots'}" />
                        </Border>
                    </Grid>

                    <ListView
                        x:Name="SlotsList"
                        Grid.Row="1"
                        SelectionChanged="OnSelectionChanged"
                        SelectionMode="Single"
                        SingleSelectionFollowsFocus="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="10"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="112"
                                            Height="64"
                                            CornerRadius="6">
                                            <Grid>
                                                <Image
                                                    Source="{Binding ThumbnailSource}"
                                                    Stretch="UniformToFill" />
                                                <Border
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Padding="6,2"
                                                    Background="#C0000000"
                                                    CornerRadius="0,4,0,0">
                                                    <TextBlock
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        Text="{Binding MissionCodeDisplay}" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="3">
                                            <TextBlock
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding MetadataSummary}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                FontSize="11"
                                                Text="{Binding UpdatedDisplay}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="3">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Text="{Binding SizeDisplay}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                FontFamily="Consolas"
                                                FontSize="10"
                                                Text="{Binding HashDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border
                        Grid.Row="2"
                        Margin="4,8,4,0"
                        Padding="10,8"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="13"
                                Glyph="&#xE838;" />
                            <TextBlock
                                x:Name="RootPathText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontFamily="Consolas"
                                FontSize="11"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
                        </Grid>
                    </Border>
                </Grid>

                <Rectangle
                    Grid.Column="1"
                    Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <ScrollViewer Grid.Column="2">
                    <Grid Padding="24,20,24,24">
                        <StackPanel x:Name="EmptySelectionText" VerticalAlignment="Center" Spacing="10">
                            <FontIcon
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                FontSize="40"
                                Glyph="&#xE74E;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{i18n:Loc Key='game_saves.select_a_live_save_slot'}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{i18n:Loc Key='game_saves.its_checkpoint_details_and_matching_backu_9effab'}" />
                        </StackPanel>

                        <StackPanel
                            x:Name="DetailsGrid"
                            Spacing="16"
                            Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        x:Name="SelectedSaveNameText"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        Text="{i18n:Loc Key='game_saves.selected_save'}" />
                                    <TextBlock
                                        x:Name="SelectedSaveSummaryText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button
                                    x:Name="ExportButton"
                                    Grid.Column="1"
                                    Click="OnExport"
                                    IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE896;" />
                                        <TextBlock Text="{i18n:Loc Key='game_saves.export_copy'}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Padding="12"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    CornerRadius="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{i18n:Loc Key='game_saves.mission'}" />
                                        <TextBlock
                                            x:Name="ScenarioText"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="12"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    CornerRadius="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{i18n:Loc Key='game_saves.difficulty'}" />
                                        <TextBlock
                                            x:Name="DifficultyText"
                                            FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    Padding="12"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    CornerRadius="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{i18n:Loc Key='game_saves.checkpoint'}" />
                                        <TextBlock
                                            x:Name="CheckpointText"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border
                                Padding="12"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                CornerRadius="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{i18n:Loc Key='game_saves.active_skulls'}" />
                                    <TextBlock
                                        x:Name="SkullsText"
                                        Grid.Column="1"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Expander
                                Header="{i18n:Loc Key='game_saves.technical_details'}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                                <Grid
                                    Padding="12,4,12,10"
                                    ColumnSpacing="14"
                                    RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{i18n:Loc Key='game_saves.type'}" />
                                    <TextBlock x:Name="KindText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="{i18n:Loc Key='game_saves.build'}" />
                                    <TextBlock x:Name="BuildText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ContainerLabelText" Grid.Row="2" FontWeight="SemiBold" Text="{i18n:Loc Key='game_saves.container'}" />
                                    <TextBlock x:Name="ContainerText" Grid.Row="2" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="{i18n:Loc Key='game_saves.updated'}" />
                                    <TextBlock x:Name="UpdatedText" Grid.Row="3" Grid.Column="1" />
                                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="{i18n:Loc Key='game_saves.file'}" />
                                    <TextBlock x:Name="FileText" Grid.Row="4" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" />
                                </Grid>
                            </Expander>

                            <Border
                                Padding="16"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:Loc Key='game_saves.recovery_library'}" />
                                            <TextBlock
                                                x:Name="BackupLibraryCountText"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                FontSize="12"
                                                Text="{i18n:Loc Key='game_saves.no_backups_available'}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Click="OnOpenBackups"
                                            ToolTipService.ToolTip="{i18n:Loc Key='game_saves.open_backup_library'}">
                                            <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                                        </Button>
                                    </Grid>

                                    <ComboBox
                                        x:Name="BackupBox"
                                        HorizontalAlignment="Stretch"
                                        PlaceholderText="{i18n:Loc Key='game_saves.choose_a_backup_or_imported_archive'}"
                                        SelectionChanged="OnBackupSelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel MaxWidth="600" Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        FontSize="11"
                                                        Text="{Binding Detail}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock
                                        x:Name="BackupMetadataText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{i18n:Loc Key='game_saves.create_a_backup_or_import_an_archive_to_p_ac8fa1'}"
                                        TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Click="OnBackupAll" Content="{i18n:Loc Key='game_saves.back_up_all_slots'}" />
                                        <Button Grid.Column="1" Click="OnImport" Content="{i18n:Loc Key='game_saves.import_archive'}" />
                                        <Button
                                            x:Name="RestoreButton"
                                            Grid.Column="3"
                                            Click="OnRestoreBackup"
                                            Content="{i18n:Loc Key='game_saves.restore_to_this_slot'}"
                                            IsEnabled="False"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                    </Grid>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="13"
                                            Glyph="&#xE946;" />
                                        <TextBlock
                                            x:Name="RecoveryHintText"
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="{i18n:Loc Key='game_saves.restoring_first_creates_a_complete_safety_6c55da'}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <InfoBar
            x:Name="PageStatus"
            Grid.Row="3"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
