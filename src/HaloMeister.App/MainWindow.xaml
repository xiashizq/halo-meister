<Window
    x:Class="HaloMeister.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:HaloMeister.App.Localization"
    Title="Halo Meister">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="18,10,14,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="11">
                    <Border
                        Width="32"
                        Height="32"
                        CornerRadius="8">
                        <Image
                            Source="ms-appx:///Assets/HaloMeisterIcon.png"
                            Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Halo Meister" />
                        <TextBlock
                            x:Name="AppTaglineText"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{i18n:Loc Key='shell.meteorite_saves_settings_live_tools'}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <ProgressRing
                        x:Name="GameConnectionProgress"
                        Width="18"
                        Height="18"
                        IsActive="False" />
                    <Ellipse
                        x:Name="GameConnectionIndicator"
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        x:Name="GameConnectionText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{i18n:Loc Key='shell.game_disconnected'}" />
                    <Button
                        x:Name="GameConnectionButton"
                        Click="OnConnectGame"
                        Content="{i18n:Loc Key='shell.connect'}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="264"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeNavItem"
                    Content="{i18n:Loc Key='shell.home'}"
                    Icon="Home"
                    Tag="home" />

                <NavigationViewItem
                    x:Name="ProgressProfileNavItem"
                    Content="{i18n:Loc Key='shell.progress_profile'}"
                    Icon="Map"
                    IsExpanded="False"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem
                            x:Name="CampaignProgressNavItem"
                            Content="{i18n:Loc Key='shell.campaign_progress'}"
                            Icon="Map"
                            Tag="campaign-progress" />
                        <NavigationViewItem x:Name="ProfileNavItem" Content="{i18n:Loc Key='shell.profile_entitlements'}" Icon="Contact" Tag="profile" />
                        <NavigationViewItem x:Name="RawNavItem" Content="{i18n:Loc Key='shell.raw_save_data'}" Icon="Document" Tag="raw" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="GameFilesNavItem"
                    Content="{i18n:Loc Key='shell.game_files'}"
                    Icon="Folder"
                    IsExpanded="False"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Name="CustomizationNavItem" Content="{i18n:Loc Key='shell.customization'}" Icon="Edit" Tag="customization" />
                        <NavigationViewItem x:Name="ConfigNavItem" Content="{i18n:Loc Key='shell.game_settings'}" Icon="Setting" Tag="config" />
                        <NavigationViewItem x:Name="GameSavesNavItem" Content="{i18n:Loc Key='shell.game_saves'}" Icon="SaveLocal" Tag="game-saves" />
                        <NavigationViewItem x:Name="BuiltinModNavItem" Content="{i18n:Loc Key='shell.builtin_mod'}" Icon="Library" Tag="builtin-mod" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="LiveToolsNavItem"
                    Content="{i18n:Loc Key='shell.live_tools'}"
                    Icon="Play"
                    IsExpanded="False"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Name="GameplayNavItem" Content="{i18n:Loc Key='shell.gameplay'}" Icon="Repair" Tag="live-gameplay" />
                        <NavigationViewItem x:Name="SpawnEquipNavItem" Content="{i18n:Loc Key='shell.spawn_equip'}" Icon="Add" Tag="live-spawn" />
                        <NavigationViewItem x:Name="AllegianceNavItem" Content="{i18n:Loc Key='shell.allegiance'}" Tag="live-allegiance">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE99A;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <!-- Temporarily hidden
                        <NavigationViewItem x:Name="AiBattleNavItem" Content="{i18n:Loc Key='shell.ai_battle'}" Tag="live-ai-battle">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8F2;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        -->
                        <NavigationViewItem x:Name="PlayerAppearanceNavItem" Content="{i18n:Loc Key='shell.player_appearance'}" Icon="Contact" Tag="live-player" />
                        <NavigationViewItem x:Name="CameraWorldNavItem" Content="{i18n:Loc Key='shell.camera_world'}" Icon="Video" Tag="live-world" />
                        <NavigationViewItem x:Name="CinematicsNavItem" Content="{i18n:Loc Key='shell.cinematics'}" Tag="cinematics">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE786;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="MusicNavItem"
                    Content="{i18n:Loc Key='shell.music'}"
                    Icon="Audio"
                    Tag="music" />

                <NavigationViewItem
                    x:Name="CharacterModelsNavItem"
                    Content="{i18n:Loc Key='shell.character_models'}"
                    Icon="People"
                    Tag="character-models" />

                <NavigationViewItem
                    x:Name="ChangeBipedNavItem"
                    Content="{i18n:Loc Key='shell.change_character'}"
                    Icon="Contact"
                    Tag="change-biped" />

                <NavigationViewItem
                    x:Name="AdvancedNavItem"
                    Content="{i18n:Loc Key='shell.advanced'}"
                    Icon="Repair"
                    IsExpanded="False"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <!-- Temporarily hidden: realtime tags menu entry
                        <NavigationViewItem x:Name="RuntimeTagsNavItem" Content="{i18n:Loc Key='shell.realtime_tags'}" Icon="Bullets" Tag="runtime-tags" />
                        -->
                        <NavigationViewItem x:Name="ScriptingNavItem" Content="{i18n:Loc Key='shell.scripting'}" Icon="Keyboard" Tag="scripting" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="RemoteNavItem" Content="{i18n:Loc Key='shell.phone_remote'}" Icon="World" Tag="phone-remote" />
                <NavigationViewItem x:Name="SetupNavItem" Content="{i18n:Loc Key='shell.setup'}" Icon="Setting" Tag="setup" />
                <NavigationViewItem x:Name="HelpNavItem" Content="{i18n:Loc Key='shell.help'}" Icon="Help" Tag="help" />
                <!-- Temporarily hidden: community & links menu entry
                <NavigationViewItem x:Name="CommunityNavItem" Content="{i18n:Loc Key='shell.community_links'}" Icon="People" Tag="community" />
                -->
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    x:Name="CloudActionsBar"
                    Padding="28,8,16,8"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="CloudTitleText" FontWeight="SemiBold" Text="{i18n:Loc Key='shell.playfab_cloud_save'}" />
                            <TextBlock
                                x:Name="CloudContextText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{i18n:Loc Key='shell.authenticate_download_then_review_your_ca_df834a'}" />
                        </StackPanel>
                        <CommandBar
                            Grid.Column="1"
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsOpen="False">
                            <AppBarButton
                                x:Name="SaveAuthButton"
                                Click="OnSaveAuth"
                                Icon="Permissions"
                                Label="{i18n:Loc Key='shell.authenticate'}" />
                            <AppBarButton
                                x:Name="GetUserDataButton"
                                Click="OnGetUserData"
                                Icon="Download"
                                IsEnabled="False"
                                Label="{i18n:Loc Key='shell.download_save'}" />
                            <AppBarButton
                                x:Name="PatchSettingsButton"
                                Click="OnPatchSettings"
                                Icon="Upload"
                                IsEnabled="False"
                                Label="{i18n:Loc Key='shell.upload_changes'}" />
                        </CommandBar>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <Frame
                        x:Name="ContentFrame"
                        CacheSize="32" />
                    <Grid
                        x:Name="NavigationLoadingOverlay"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <ProgressRing
                                x:Name="NavigationLoadingRing"
                                Width="40"
                                Height="40"
                                IsActive="False" />
                            <TextBlock
                                x:Name="NavigationLoadingText"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{i18n:Loc Key='common.loading'}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>

        <StackPanel
            Grid.RowSpan="2"
            Margin="20,0,20,20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="30"
            Spacing="12">
            <StackPanel.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="ToastFillBrush" Color="#FF2C2C2C" />
                            <SolidColorBrush x:Key="ToastTextBrush" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="ToastStrokeBrush" Color="#FF4A4A4A" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="ToastFillBrush" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="ToastTextBrush" Color="#FF1A1A1A" />
                            <SolidColorBrush x:Key="ToastStrokeBrush" Color="#FFD0D0D0" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </StackPanel.Resources>
            <InfoBar
                x:Name="Status"
                Width="520"
                HorizontalAlignment="Right"
                Background="{ThemeResource ToastFillBrush}"
                BorderBrush="{ThemeResource ToastStrokeBrush}"
                Foreground="{ThemeResource ToastTextBrush}"
                IsClosable="True"
                IsOpen="False"
                Visibility="Collapsed">
                <InfoBar.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#FF2C2C2C" />
                                <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#FF2C2C2C" />
                                <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#FF2C2C2C" />
                                <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#FF2C2C2C" />
                                <SolidColorBrush x:Key="InfoBarTitleForeground" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="InfoBarMessageForeground" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="InfoBarInformationalSeverityIconForeground" Color="#FF000000" />
                                <SolidColorBrush x:Key="InfoBarBorderBrush" Color="#FF4A4A4A" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="InfoBarTitleForeground" Color="#FF1A1A1A" />
                                <SolidColorBrush x:Key="InfoBarMessageForeground" Color="#FF1A1A1A" />
                                <SolidColorBrush x:Key="InfoBarInformationalSeverityIconForeground" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="InfoBarBorderBrush" Color="#FFD0D0D0" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </InfoBar.Resources>
            </InfoBar>
            <Border
                x:Name="LiveToolsStatusCard"
                MaxWidth="380"
                Padding="16,14"
                HorizontalAlignment="Right"
                Background="{ThemeResource ToastFillBrush}"
                BorderBrush="{ThemeResource ToastStrokeBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Top">
                    <ProgressRing
                        x:Name="LiveToolsCardRing"
                        Width="28"
                        Height="28"
                        IsActive="False" />
                    <SymbolIcon
                        x:Name="LiveToolsCardIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Symbol="Accept"
                        Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock
                        x:Name="LiveToolsCardTitle"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource ToastTextBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="LiveToolsCardDetail"
                        FontSize="12"
                        Foreground="{ThemeResource ToastTextBrush}"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        x:Name="LiveToolsCardProgress"
                        Maximum="100"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="LiveToolsCardAction"
                        HorizontalAlignment="Left"
                        Click="OnLiveToolsCardAction"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
        </StackPanel>
    </Grid>
</Window>
